{{define "tool-header"}}
<header class="w-full max-w-6xl mx-auto pt-4 px-4 sm:px-6 mb-6 shrink-0">
  <div class="w-full px-4 py-2.5 rounded-xl border flex items-center justify-between shadow-sm transition-colors" style="background: var(--surface-soft); border-color: var(--border);">
    <!-- Left: Back Button & VoidLAB Logo (Exact 1:1 with Screenshots) -->
    <div class="flex items-center gap-3">
      <a
        href="/editor"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold border transition-all hover:bg-[var(--control-hover)] cursor-pointer"
        style="background: var(--control-background); border-color: var(--border); color: var(--text);"
        title="Return to Main Code Editor"
      >
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
        <span>Back</span>
      </a>

      <a href="/editor" class="flex items-center gap-2 group transition-opacity hover:opacity-90">
        <svg
          width="26"
          height="26"
          viewBox="0 0 128 128"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          class="brand-logo-fill flex-shrink-0"
        >
          <path d="M18 10 L54 110 L64 90 L36 10 Z" fill="currentColor" />
          <path d="M110 10 L74 110 L64 90 L92 10 Z" fill="currentColor" />
          <path d="M80 8 L44 122" stroke="currentColor" stroke-width="7" stroke-linecap="round" />
        </svg>
        <span class="display-font font-bold text-base tracking-tight text-[var(--text-strong)]">
          VoidLAB
        </span>
      </a>
    </div>

    <!-- Right: Theme Switch, User Profile Pill, Logout -->
    <div class="flex items-center gap-2.5">
      <!-- Theme Switcher Pill -->
      <button
        onclick="toggleVoidLabTheme()"
        hx-post="/api/ui/theme"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-medium border transition-colors cursor-pointer"
        style="background: var(--control-background); border-color: var(--border); color: var(--text);"
        title="Toggle Dark / Light Theme"
        type="button"
      >
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-sky-500">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
        <span class="hidden sm:inline text-xs">Dark</span>
      </button>

      <!-- User Profile Badge Pill -->
      <a
        href="/editor/profile"
        class="inline-flex items-center gap-2 px-3 py-1 rounded-xl border transition-all hover:bg-[var(--control-hover)]"
        style="background: var(--control-background); border-color: var(--border);"
        title="View Developer Profile"
      >
        <div class="w-6 h-6 rounded-full flex items-center justify-center font-bold text-[11px] bg-[var(--accent-soft)] text-[var(--accent)] border border-[var(--border)] shrink-0 voidlab-user-initial">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
        </div>
        <div class="flex flex-col text-left leading-tight hidden sm:flex">
          <span class="text-xs font-bold text-[var(--text-strong)] voidlab-user-name">{{if .User}}{{.User}}{{else}}Alex{{end}}</span>
          <span class="text-[10px] text-[var(--muted)]">{{if .User}}{{.User}}@local.dev{{else}}me@local.dev{{end}}</span>
        </div>
      </a>

      <!-- Logout Button -->
      <button
        hx-post="/api/auth/logout"
        onclick="window.voidlabLogout()"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border text-xs font-medium transition-colors hover:text-rose-500 hover:border-rose-500/30 cursor-pointer"
        style="background: var(--control-background); border-color: var(--border); color: var(--text);"
        title="Sign Out of Session"
        type="button"
      >
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
          <polyline points="16 17 21 12 16 7"></polyline>
          <line x1="21" y1="12" x2="9" y2="12"></line>
        </svg>
        <span class="hidden sm:inline">Logout</span>
      </button>
    </div>
  </div>
</header>
{{end}}
