{{define "collab"}}
<div
  id="collab-view"
  class="flex-1 flex flex-col h-full overflow-hidden select-none font-sans transition-colors"
  style="background: var(--background-main); color: var(--text);"
>
  <!-- ── Top Header Toolbar ── -->
  <div
    class="h-9 px-3 flex items-center justify-between shrink-0 select-none font-sans text-xs border-b transition-colors"
    style="background: var(--surface-soft); border-color: var(--border);"
  >
    <div class="flex items-center gap-2">
      <span class="w-2 h-2 rounded-full" style="background: var(--accent);"></span>
      <span class="font-bold tracking-tight text-xs" style="color: var(--text-strong);">Multiplayer Collaboration</span>
      <span class="text-[10px] px-1.5 py-0.5 rounded font-mono" style="background: var(--control-background); border: 1px solid var(--border); color: var(--muted);">
        Peer-to-Peer WebSocket
      </span>
    </div>

    <!-- Back to Editor Button -->
    <button
      hx-get="/api/ui/editor"
      hx-target="#main-editor-pane"
      hx-swap="innerHTML"
      class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-medium rounded-md transition-colors hover:bg-[var(--control-hover)] border border-[var(--border)] cursor-pointer"
      style="color: var(--text);"
      title="Return to code editor"
      type="button"
    >
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="16 18 22 12 16 6"></polyline>
        <polyline points="8 6 2 12 8 18"></polyline>
      </svg>
      <span>Editor</span>
    </button>
  </div>

  <!-- ── Collab Main Content ── -->
  <div class="flex-1 overflow-y-auto p-5 space-y-5 scrollbar-thin text-xs font-sans">
    <!-- Active Room Status Banner -->
    <div
      class="p-4 rounded-xl border flex items-center justify-between transition-colors shadow-sm"
      style="background: var(--surface-soft); border-color: var(--border-strong);"
    >
      <div>
        <div class="font-bold text-sm" style="color: var(--text-strong);">Active Pair Room: VOID-LAB-01</div>
        <div class="text-[11px] mt-0.5" style="color: var(--muted);">
          WebSocket synchronized live session for pair-programming and code reviews.
        </div>
      </div>
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-semibold bg-emerald-500/10 text-emerald-500 border border-emerald-500/20">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
          Connected
        </span>
      </div>
    </div>

    <!-- Participants Grid -->
    <div class="space-y-2">
      <div class="text-[11px] font-bold uppercase tracking-wider text-[var(--muted)]">Active Collaborators (2 Online)</div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <!-- Host -->
        <div class="p-3 rounded-lg border border-[var(--border)] bg-[var(--panel-background)] flex items-center gap-3">
          <div class="w-8 h-8 rounded-full bg-[var(--accent)] text-white font-bold text-xs flex items-center justify-center shrink-0">
            {{if .UserInitial}}{{.UserInitial}}{{else}}R{{end}}
          </div>
          <div class="min-w-0 flex-1">
            <div class="font-semibold text-xs truncate" style="color: var(--text-strong);">
              {{if .User}}{{.User}}{{else}}Rudra{{end}} (You)
            </div>
            <div class="text-[10px] text-emerald-500 flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              Host & Editor
            </div>
          </div>
        </div>

        <!-- Peer -->
        <div class="p-3 rounded-lg border border-[var(--border)] bg-[var(--panel-background)] flex items-center gap-3">
          <div class="w-8 h-8 rounded-full bg-indigo-500 text-white font-bold text-xs flex items-center justify-center shrink-0">
            A
          </div>
          <div class="min-w-0 flex-1">
            <div class="font-semibold text-xs truncate" style="color: var(--text-strong);">
              Alex Mercer
            </div>
            <div class="text-[10px] text-sky-500 flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-sky-500"></span>
              Reviewer / Cursor Sync
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Interactive Room Launcher / Connect Card -->
    <div class="p-4 rounded-xl border border-[var(--border)] bg-[var(--panel-background)] space-y-3">
      <div class="font-bold text-xs text-[var(--text-strong)]">Join or Spawn a Peer Room</div>
      <div class="flex flex-col sm:flex-row gap-2">
        <input
          type="text"
          id="collab-room-input"
          value="VOID-PAIR-77"
          placeholder="Enter room token (e.g. VOID-ROOM-01)"
          class="flex-1 px-3 py-2 text-xs rounded-lg border outline-none font-mono transition-colors"
          style="background: var(--input-background); border-color: var(--border); color: var(--text);"
        />
        <button
          hx-post="/api/collab/room"
          hx-include="#collab-room-input"
          hx-target="#collab-log"
          hx-swap="beforeend"
          class="px-4 py-2 rounded-lg text-xs font-semibold text-white transition-all cursor-pointer shadow-sm hover:shadow"
          style="background: var(--action-background);"
          type="button"
        >
          Connect Room
        </button>
      </div>
      <div id="collab-log" class="text-[11px] font-mono text-[var(--muted)] pt-1">
        ✓ WebSocket signaling endpoint ready at /api/collab/room
      </div>
    </div>
  </div>
</div>
{{end}}

{{define "collab.tmpl"}}
  {{template "collab" .}}
{{end}}
