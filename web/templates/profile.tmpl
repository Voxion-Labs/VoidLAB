{{define "profile"}}
<div
  id="profile-view"
  class="flex-1 flex flex-col h-full overflow-hidden select-none font-sans transition-colors"
  style="background: var(--background-main); color: var(--text);"
>
  <!-- ── Top Header Toolbar ── -->
  <div
    class="h-9 px-3 flex items-center justify-between shrink-0 select-none font-sans text-xs border-b transition-colors"
    style="background: var(--surface-soft); border-color: var(--border);"
  >
    <div class="flex items-center gap-2">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--accent);">
        <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
        <circle cx="12" cy="7" r="4"></circle>
      </svg>
      <span class="font-bold tracking-tight text-xs" style="color: var(--text-strong);">Developer Profile</span>
      <span class="text-[10px] px-1.5 py-0.5 rounded font-mono" style="background: var(--control-background); border: 1px solid var(--border); color: var(--muted);">
        Authenticated Session
      </span>
    </div>

    <!-- Back to Editor Button -->
    <button
      hx-get="/api/ui/editor"
      hx-target="#main-editor-pane"
      hx-swap="innerHTML"
      class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-medium rounded-md transition-colors hover:bg-[var(--control-hover)] border border-[var(--border)] cursor-pointer"
      style="color: var(--text);"
      title="Return to code editor"
      type="button"
    >
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="16 18 22 12 16 6"></polyline>
        <polyline points="8 6 2 12 8 18"></polyline>
      </svg>
      <span>Editor</span>
    </button>
  </div>

  <!-- ── Profile Main Content ── -->
  <div class="flex-1 overflow-y-auto p-5 space-y-5 scrollbar-thin text-xs font-sans">
    <!-- User Card -->
    <div class="p-5 rounded-2xl border flex items-center gap-4 transition-colors shadow-sm" style="background: var(--surface-soft); border-color: var(--border);">
      <div class="w-14 h-14 rounded-full bg-[var(--accent)] text-white font-extrabold text-xl flex items-center justify-center shadow-md shrink-0">
        {{if .UserInitial}}{{.UserInitial}}{{else}}R{{end}}
      </div>
      <div class="min-w-0 flex-1">
        <div class="flex items-center gap-2">
          <h2 class="text-base font-bold font-display" style="color: var(--text-strong);">
            {{if .User}}{{.User}}{{else}}Rudra{{end}}
          </h2>
          <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-500/10 text-emerald-500 border border-emerald-500/20">
            Active
          </span>
        </div>
        <div class="text-xs mt-0.5" style="color: var(--muted);">Voxion Labs Principal Engineer</div>
        <div class="text-[11px] font-mono mt-1 text-[var(--accent)]">engineer@voxion.dev</div>
      </div>
    </div>

    <!-- Session Security Details -->
    <div class="p-4 rounded-xl border border-[var(--border)] bg-[var(--panel-background)] space-y-2">
      <div class="font-bold text-xs flex items-center gap-1.5" style="color: var(--text-strong);">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-500">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
        Session Security Guard
      </div>
      <p class="text-[11px] leading-relaxed text-[var(--muted)]">
        This session is guarded by a secure HTTP-Only cookie (<code class="font-mono text-emerald-500">voidlab_session</code>). JavaScript execution cannot access or manipulate the authentication credentials, completely mitigating XSS token extraction.
      </p>
    </div>

    <!-- Workspace Environment Metrics -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      <div class="p-3 rounded-xl border border-[var(--border)] bg-[var(--surface-soft)] space-y-1">
        <div class="text-[10px] font-semibold uppercase tracking-wider text-[var(--muted)]">Execution Pipeline</div>
        <div class="font-semibold text-xs text-[var(--text-strong)]">Dual-Engine (Docker + Local)</div>
        <div class="text-[10px] text-[var(--muted)]">256MB RAM / 0.5 CPU isolated limits</div>
      </div>

      <div class="p-3 rounded-xl border border-[var(--border)] bg-[var(--surface-soft)] space-y-1">
        <div class="text-[10px] font-semibold uppercase tracking-wider text-[var(--muted)]">Client Engine</div>
        <div class="font-semibold text-xs text-[var(--text-strong)]">WebAssembly (Go Core)</div>
        <div class="text-[10px] text-[var(--muted)]">Sub-millisecond parsing and formatting</div>
      </div>
    </div>

    <!-- Account Actions -->
    <div class="pt-2 flex items-center gap-3">
      <button
        hx-post="/api/auth/logout"
        class="inline-flex items-center gap-1.5 px-4 py-2 text-xs font-semibold rounded-lg transition-colors text-white bg-rose-600 hover:bg-rose-700 shadow-sm cursor-pointer"
        type="button"
      >
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
          <polyline points="16 17 21 12 16 7"></polyline>
          <line x1="21" y1="12" x2="9" y2="12"></line>
        </svg>
        <span>Sign Out</span>
      </button>

      <button
        hx-get="/api/ui/modal/settings"
        hx-target="#modal-container"
        hx-swap="innerHTML"
        class="inline-flex items-center gap-1.5 px-4 py-2 text-xs font-semibold rounded-lg transition-colors border border-[var(--border)] bg-[var(--control-background)] hover:bg-[var(--control-hover)] text-[var(--text)] cursor-pointer"
        type="button"
      >
        Workspace Preferences
      </button>
    </div>
  </div>
</div>
{{end}}

{{define "profile.tmpl"}}
  {{template "profile" .}}
{{end}}
