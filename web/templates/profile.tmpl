{{define "profile"}}
<div
  id="profile-view"
  class="flex-1 flex flex-col h-full overflow-hidden select-none font-sans transition-colors"
  style="background: var(--background-main); color: var(--text);"
>
  <!-- ── Top Header Toolbar ── -->
  <div
    class="h-9 px-3 flex items-center justify-between shrink-0 select-none font-sans text-xs border-b transition-colors"
    style="background: var(--surface-soft); border-color: var(--border);"
  >
    <div class="flex items-center gap-2">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--accent);">
        <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
        <circle cx="12" cy="7" r="4"></circle>
      </svg>
      <span class="font-bold tracking-tight text-xs" style="color: var(--text-strong);">Developer Profile</span>
      <span class="text-[10px] px-1.5 py-0.5 rounded font-mono" style="background: var(--control-background); border: 1px solid var(--border); color: var(--muted);">
        Authenticated Session
      </span>
    </div>

    <!-- Close Side Panel Button (Directive 1) -->
    <button
      onclick="closeSidePanel()"
      class="inline-flex items-center justify-center w-6 h-6 rounded text-xs font-medium hover:bg-[var(--control-hover)] transition-colors cursor-pointer text-[var(--muted)] hover:text-[var(--text-strong)]"
      title="Close Profile side-panel"
      type="button"
    >
      <span>✕</span>
    </button>
  </div>

  <!-- ── Profile Main Content ── -->
  <div class="flex-1 overflow-y-auto p-5 space-y-5 scrollbar-thin text-xs font-sans">
    <!-- User Card (Stateless: Preserved in browser localStorage) -->
    <div class="p-4 rounded-xl border flex items-center gap-3.5 transition-colors shadow-sm" style="background: var(--surface-soft); border-color: var(--border);">
      <div class="w-12 h-12 rounded-full bg-[var(--accent)] text-white font-extrabold text-lg flex items-center justify-center shadow-md shrink-0 voidlab-user-initial">
        {{if .UserInitial}}{{.UserInitial}}{{else}}D{{end}}
      </div>
      <div class="min-w-0 flex-1">
        <div class="flex items-center gap-2">
          <h2 class="text-sm font-bold font-display voidlab-user-name" style="color: var(--text-strong);">
            {{if .User}}{{.User}}{{else}}Developer{{end}}
          </h2>
          <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-500/10 text-emerald-500 border border-emerald-500/20">
            Browser Local
          </span>
        </div>
        <div class="text-[11px] mt-0.5 text-[var(--muted)]">100% Stateless: Zero Server Database</div>
      </div>
    </div>

    <!-- Edit Local Identity Form -->
    <form onsubmit="event.preventDefault(); var u = document.getElementById('edit-profile-username').value.trim(); if(u) { window.voidlabSaveProfile(u); alert('Profile updated in browser localStorage!'); }" class="p-3.5 rounded-xl border border-[var(--border)] bg-[var(--panel-background)] space-y-3">
      <div class="font-bold text-xs text-[var(--text-strong)] flex items-center gap-1.5">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
        Edit Local Username
      </div>
      <div>
        <label class="block text-[10px] font-semibold text-[var(--muted)] uppercase tracking-wider mb-1">Username</label>
        <input
          id="edit-profile-username"
          type="text"
          value="{{if .User}}{{.User}}{{else}}Developer{{end}}"
          class="w-full px-2.5 py-1.5 rounded text-xs bg-[var(--input-background)] border border-[var(--border)] text-[var(--text)] outline-none focus:border-[var(--accent)] font-sans"
        />
      </div>
      <button
        type="submit"
        class="w-full py-1.5 px-3 rounded text-xs font-semibold bg-[var(--action-background)] text-[var(--action-foreground)] shadow-sm hover:opacity-90 transition-all cursor-pointer"
      >
        Save to LocalStorage
      </button>
    </form>

    <!-- Stateless Storage Details -->
    <div class="p-3.5 rounded-xl border border-[var(--border)] bg-[var(--surface-soft)] space-y-1.5">
      <div class="font-bold text-xs flex items-center gap-1.5 text-emerald-500">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
        Stateless Architecture
      </div>
      <p class="text-[11px] leading-relaxed text-[var(--muted)]">
        VoidLAB runs with <strong>0 server-side database</strong>. All identity tokens, workspaces, and preferences reside locally in <code>localStorage</code>.
      </p>
    </div>

    <!-- Workspace Environment Metrics -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      <div class="p-3 rounded-xl border border-[var(--border)] bg-[var(--surface-soft)] space-y-1">
        <div class="text-[10px] font-semibold uppercase tracking-wider text-[var(--muted)]">Execution Pipeline</div>
        <div class="font-semibold text-xs text-[var(--text-strong)]">Dual-Engine (Docker + Local)</div>
        <div class="text-[10px] text-[var(--muted)]">256MB RAM / 0.5 CPU isolated limits</div>
      </div>

      <div class="p-3 rounded-xl border border-[var(--border)] bg-[var(--surface-soft)] space-y-1">
        <div class="text-[10px] font-semibold uppercase tracking-wider text-[var(--muted)]">Client Engine</div>
        <div class="font-semibold text-xs text-[var(--text-strong)]">WebAssembly (Go Core)</div>
        <div class="text-[10px] text-[var(--muted)]">Sub-millisecond parsing and formatting</div>
      </div>
    </div>

    <!-- Account Actions -->
    <div class="pt-2 flex items-center gap-3">
      <button
        hx-post="/api/auth/logout" onclick="window.voidlabLogout()"
        class="inline-flex items-center gap-1.5 px-4 py-2 text-xs font-semibold rounded-lg transition-colors text-white bg-rose-600 hover:bg-rose-700 shadow-sm cursor-pointer"
        type="button"
      >
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
          <polyline points="16 17 21 12 16 7"></polyline>
          <line x1="21" y1="12" x2="9" y2="12"></line>
        </svg>
        <span>Sign Out</span>
      </button>

      <button
        hx-get="/api/ui/modal/settings"
        hx-target="#modal-container"
        hx-swap="innerHTML"
        class="inline-flex items-center gap-1.5 px-4 py-2 text-xs font-semibold rounded-lg transition-colors border border-[var(--border)] bg-[var(--control-background)] hover:bg-[var(--control-hover)] text-[var(--text)] cursor-pointer"
        type="button"
      >
        Workspace Preferences
      </button>
    </div>
  </div>
</div>
{{end}}

{{define "profile.tmpl"}}
  {{template "profile" .}}
{{end}}
