{{define "profile"}}
<!-- Fragment compatibility for side-panel or dynamic swaps -->
<div id="profile-view" class="flex-1 flex flex-col h-full overflow-hidden select-none font-sans transition-colors" style="background: var(--background-main); color: var(--text);">
  <div class="h-10 px-4 flex items-center justify-between shrink-0 border-b select-none transition-colors" style="background: var(--surface-soft); border-color: var(--border);">
    <div class="flex items-center gap-2">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--accent);"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
      <span class="font-bold tracking-tight text-xs text-[var(--text-strong)]">Developer Profile</span>
    </div>
    <a href="/editor/profile" class="text-xs px-2.5 py-1 rounded bg-[var(--control-background)] hover:bg-[var(--control-hover)] border border-[var(--border)] text-[var(--text)] transition cursor-pointer">
      Open Full Page ↗
    </a>
  </div>
  <div class="p-4 text-xs text-[var(--muted)]">
    Manage your developer credentials, local workspace metrics, and session audit history.
  </div>
</div>
{{end}}

{{define "profile-page"}}
<main class="min-h-screen w-full flex flex-col font-sans select-none antialiased transition-colors" style="background: var(--background-main); color: var(--text);">
  <!-- Universal Tool Header (← Back, VoidLAB Logo, Theme, Profile, Logout) -->
  {{template "tool-header" .}}

  <!-- Main Profile Content Container (Exact 1:1 with Screenshot 4) -->
  <div class="w-full max-w-6xl mx-auto px-4 sm:px-6 pb-12">
    <!-- Category Badge -->
    <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-[11px] font-bold uppercase tracking-wider mb-2.5" style="background: var(--accent-soft); color: var(--accent);">
      ACCOUNT SETTINGS
    </div>

    <!-- Page Title & Subtitle -->
    <h1 class="text-3xl font-extrabold tracking-tight display-font text-[var(--text-strong)] mb-2">
      Developer Profile & Identity
    </h1>
    <p class="text-xs sm:text-sm text-[var(--muted)] max-w-3xl leading-relaxed mb-6">
      Manage your local authentication credentials, profile identity, connected services, and session audit activity.
    </p>

    <!-- Top Hero Card (Exact 1:1 with Screenshot 4) -->
    <div class="rounded-2xl border p-5 sm:p-6 mb-6 flex flex-col md:flex-row items-start md:items-center justify-between gap-5 shadow-sm transition-colors" style="background: var(--surface-soft); border-color: var(--border);">
      <div class="flex items-center gap-4">
        <!-- User Avatar with Camera Badge -->
        <div class="relative">
          <div class="w-14 h-14 rounded-2xl border flex items-center justify-center font-bold text-xl transition-colors shadow-inner" style="background: var(--control-background); border-color: var(--border); color: var(--text-strong);">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" style="color: var(--muted);">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
          </div>
          <button type="button" class="absolute -bottom-1 -right-1 w-6 h-6 rounded-full flex items-center justify-center text-white shadow cursor-pointer transition-transform hover:scale-110" style="background: var(--accent);" title="Change Avatar">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
              <circle cx="12" cy="13" r="4"></circle>
            </svg>
          </button>
        </div>

        <!-- Identity Details -->
        <div class="space-y-1">
          <div class="flex flex-wrap items-center gap-2">
            <h2 class="text-lg font-bold font-display text-[var(--text-strong)] voidlab-user-name">
              {{if .User}}{{.User}}{{else}}Alex{{end}}
            </h2>
            <span class="px-2 py-0.5 rounded-md text-[11px] font-mono" style="background: var(--accent-soft); color: var(--accent);">
              @localdev
            </span>
            <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-500/10 text-emerald-500 border border-emerald-500/20">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              Local Active
            </span>
          </div>
          <div class="flex flex-wrap items-center gap-2 text-xs text-[var(--muted)]">
            <span id="profile-hero-email">{{if .User}}{{.User}}@local.dev{{else}}me@local.dev{{end}}</span>
            <span>•</span>
            <span>US East (N. Virginia)</span>
            <span>•</span>
            <span class="font-mono text-[11px]">Browser Session ID: local-user-1</span>
          </div>
        </div>
      </div>

      <!-- Action: Save Changes Button -->
      <button
        type="button"
        onclick="saveFullProfileChanges()"
        class="px-5 py-2.5 rounded-xl text-xs font-bold shadow-sm transition-all hover:opacity-90 active:scale-[0.98] cursor-pointer flex items-center gap-2 shrink-0"
        style="background: var(--action-background); color: var(--action-foreground);"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
          <polyline points="17 21 17 13 7 13 7 21"></polyline>
          <polyline points="7 3 7 8 15 8"></polyline>
        </svg>
        <span>Save Changes</span>
      </button>
    </div>

    <!-- 2-Column Grid (Left: Forms & Bio / Right: Inventory & Audit Log) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      <!-- Left Column: Credentials & Bio -->
      <div class="lg:col-span-7 space-y-6">
        <!-- Card: Account Credentials & Identity (Exact 1:1 with Screenshot 4) -->
        <div class="rounded-2xl border p-5 sm:p-6 shadow-sm transition-colors space-y-4" style="background: var(--surface-soft); border-color: var(--border);">
          <div>
            <div class="flex items-center gap-2 text-xs font-bold text-[var(--text-strong)]">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--accent);">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
              <span>Account Credentials & Identity</span>
            </div>
            <p class="text-[11px] text-[var(--muted)] mt-0.5">
              Manage your credentials and local developer details used across this VoidLAB instance.
            </p>
          </div>

          <!-- 2x2 Input Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 pt-1">
            <div>
              <label class="block text-[11px] font-semibold text-[var(--muted)] mb-1">Full Name</label>
              <input
                id="prof-fullname"
                type="text"
                value="{{if .User}}{{.User}}{{else}}Alex{{end}}"
                class="w-full px-3.5 py-2.5 rounded-xl text-xs outline-none transition-colors"
                style="background: var(--input-background); border: 1px solid var(--border); color: var(--text);"
              />
            </div>
            <div>
              <label class="block text-[11px] font-semibold text-[var(--muted)] mb-1">@ Username</label>
              <input
                id="prof-username"
                type="text"
                placeholder="e.g. alexrivera"
                value="{{if .User}}{{.User}}{{else}}Alex{{end}}"
                class="w-full px-3.5 py-2.5 rounded-xl text-xs outline-none transition-colors"
                style="background: var(--input-background); border: 1px solid var(--border); color: var(--text);"
              />
            </div>
            <div>
              <label class="block text-[11px] font-semibold text-[var(--muted)] mb-1">Email Address</label>
              <input
                id="prof-email"
                type="email"
                value="{{if .User}}{{.User}}@local.dev{{else}}me@local.dev{{end}}"
                class="w-full px-3.5 py-2.5 rounded-xl text-xs outline-none transition-colors"
                style="background: var(--input-background); border: 1px solid var(--border); color: var(--text);"
              />
            </div>
            <div>
              <label class="block text-[11px] font-semibold text-[var(--muted)] mb-1">Region / Location</label>
              <input
                id="prof-region"
                type="text"
                value="US East (N. Virginia)"
                class="w-full px-3.5 py-2.5 rounded-xl text-xs outline-none transition-colors"
                style="background: var(--input-background); border: 1px solid var(--border); color: var(--text);"
              />
            </div>
          </div>

          <!-- Password / Access Key Field -->
          <div class="pt-1">
            <div class="flex items-center justify-between mb-1">
              <label class="block text-[11px] font-semibold text-[var(--muted)]">Local Password / Access Key</label>
              <button
                type="button"
                onclick="togglePasswordVisibility()"
                id="btn-toggle-pwd"
                class="text-[10px] text-[var(--accent)] hover:underline flex items-center gap-1 cursor-pointer"
              >
                Show
              </button>
            </div>
            <input
              id="prof-password"
              type="password"
              placeholder="Enter local password"
              value="••••••••••••"
              class="w-full px-3.5 py-2.5 rounded-xl text-xs outline-none transition-colors font-mono"
              style="background: var(--input-background); border: 1px solid var(--border); color: var(--text);"
            />
            <p class="text-[10px] text-[var(--muted)] mt-1.5">
              Used to authenticate this local profile session inside your browser storage.
            </p>
          </div>
        </div>

        <!-- Card: Developer Bio & Workspace Summary -->
        <div class="rounded-2xl border p-5 sm:p-6 shadow-sm transition-colors space-y-3" style="background: var(--surface-soft); border-color: var(--border);">
          <div>
            <div class="flex items-center gap-2 text-xs font-bold text-[var(--text-strong)]">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--accent);">
                <path d="M12 20h9"></path>
                <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
              </svg>
              <span>Developer Bio & Workspace Summary</span>
            </div>
            <p class="text-[11px] text-[var(--muted)] mt-0.5">
              A brief description of your technical stack and project focus.
            </p>
          </div>
          <textarea
            id="prof-bio"
            rows="3"
            class="w-full px-3.5 py-2.5 rounded-xl text-xs outline-none transition-colors resize-none leading-relaxed"
            style="background: var(--input-background); border: 1px solid var(--border); color: var(--text);"
          >Local-First Developer: Rudra</textarea>
        </div>

        <!-- Card: Connected Developer Profiles & Socials -->
        <div class="rounded-2xl border p-5 sm:p-6 shadow-sm transition-colors space-y-3" style="background: var(--surface-soft); border-color: var(--border);">
          <div>
            <div class="flex items-center gap-2 text-xs font-bold text-[var(--text-strong)]">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--accent);">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="2" y1="12" x2="22" y2="12"></line>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
              </svg>
              <span>Connected Developer Profiles & Socials</span>
            </div>
            <p class="text-[11px] text-[var(--muted)] mt-0.5">
              Link your external accounts for direct GitHub publishing and collaborative sharing.
            </p>
          </div>
          <div class="flex items-center justify-between p-3 rounded-xl border" style="background: var(--panel-background); border-color: var(--border);">
            <div class="flex items-center gap-2.5">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
              </svg>
              <div class="text-xs font-semibold text-[var(--text-strong)]">GitHub Account</div>
            </div>
            <a href="/editor/github" class="text-xs px-3 py-1.5 rounded-lg border font-medium hover:bg-[var(--control-hover)] transition-colors cursor-pointer" style="background: var(--control-background); border-color: var(--border); color: var(--text);">
              Configure
            </a>
          </div>
        </div>
      </div>

      <!-- Right Column: Workspace Inventory & Session Audit Log -->
      <div class="lg:col-span-5 space-y-6">
        <!-- Card: Workspace Inventory (Exact 1:1 with Screenshot 4) -->
        <div class="rounded-2xl border p-5 sm:p-6 shadow-sm transition-colors space-y-4" style="background: var(--surface-soft); border-color: var(--border);">
          <div class="flex items-center gap-2 text-xs font-bold text-[var(--text-strong)]">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--accent);">
              <rect width="20" height="14" x="2" y="3" rx="2"></rect>
              <line x1="8" x2="16" y1="21" y2="21"></line>
              <line x1="12" x2="12" y1="17" y2="21"></line>
            </svg>
            <span>Workspace Inventory</span>
          </div>

          <!-- Counter Cards -->
          <div class="grid grid-cols-2 gap-3">
            <div class="p-3.5 rounded-xl border flex items-center justify-between" style="background: var(--panel-background); border-color: var(--border);">
              <div>
                <div class="text-[10px] uppercase font-bold text-[var(--muted)]">Files</div>
                <div class="text-xl font-extrabold text-[var(--text-strong)] mt-0.5">2</div>
              </div>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--muted);">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
              </svg>
            </div>
            <div class="p-3.5 rounded-xl border flex items-center justify-between" style="background: var(--panel-background); border-color: var(--border);">
              <div>
                <div class="text-[10px] uppercase font-bold text-[var(--muted)]">Directories</div>
                <div class="text-xl font-extrabold text-[var(--text-strong)] mt-0.5">2</div>
              </div>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--muted);">
                <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
              </svg>
            </div>
          </div>

          <!-- Storage Mode Bar -->
          <div class="space-y-1.5 pt-1">
            <div class="flex items-center justify-between text-xs">
              <span class="text-[var(--muted)] font-medium">Storage Mode</span>
              <span class="font-semibold text-[var(--text-strong)]">IndexedDB / Local</span>
            </div>
            <div class="w-full h-1.5 rounded-full overflow-hidden" style="background: var(--border);">
              <div class="h-full rounded-full" style="width: 45%; background: var(--accent);"></div>
            </div>
            <div class="flex items-center justify-between text-[10px] text-[var(--muted)] pt-0.5">
              <span>Client Sandbox</span>
              <span class="text-emerald-500 font-semibold">Active</span>
            </div>
          </div>
        </div>

        <!-- Card: Session Audit Log (Exact 1:1 with Screenshot 4) -->
        <div class="rounded-2xl border p-5 sm:p-6 shadow-sm transition-colors space-y-3" style="background: var(--surface-soft); border-color: var(--border);">
          <div class="flex items-center justify-between pb-2 border-b" style="border-color: var(--border);">
            <div class="flex items-center gap-2 text-xs font-bold text-[var(--text-strong)]">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--accent);">
                <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
              </svg>
              <span>Session Audit Log</span>
            </div>
            <span class="px-2 py-0.5 rounded-full text-[10px] font-mono" style="background: var(--control-background); border: 1px solid var(--border); color: var(--muted);">
              16 Events
            </span>
          </div>

          <!-- Scrollable Events Feed -->
          <div class="max-h-80 overflow-y-auto space-y-2.5 scrollbar-thin pr-1 text-xs">
            <!-- Event 1 -->
            <div class="p-3 rounded-xl border space-y-1" style="background: var(--panel-background); border-color: var(--border);">
              <div class="flex items-center justify-between">
                <span class="font-bold text-[var(--text-strong)]">File created</span>
                <span class="text-[9px] font-mono px-1.5 py-0.5 rounded uppercase" style="background: var(--accent-soft); color: var(--accent);">WORKSPACE</span>
              </div>
              <p class="text-[11px] text-[var(--muted)]">Created /src/main.js.</p>
              <div class="text-[10px] text-[var(--muted)] opacity-75 font-mono">08:55 PM • 10/27/2026</div>
            </div>

            <!-- Event 2 -->
            <div class="p-3 rounded-xl border space-y-1" style="background: var(--panel-background); border-color: var(--border);">
              <div class="flex items-center justify-between">
                <span class="font-bold text-[var(--text-strong)]">Folder created</span>
                <span class="text-[9px] font-mono px-1.5 py-0.5 rounded uppercase" style="background: var(--accent-soft); color: var(--accent);">WORKSPACE</span>
              </div>
              <p class="text-[11px] text-[var(--muted)]">Created folder /ms.</p>
              <div class="text-[10px] text-[var(--muted)] opacity-75 font-mono">08:35 PM • 10/27/2026</div>
            </div>

            <!-- Event 3 -->
            <div class="p-3 rounded-xl border space-y-1" style="background: var(--panel-background); border-color: var(--border);">
              <div class="flex items-center justify-between">
                <span class="font-bold text-[var(--text-strong)]">File saved</span>
                <span class="text-[9px] font-mono px-1.5 py-0.5 rounded uppercase" style="background: var(--accent-soft); color: var(--accent);">WORKSPACE</span>
              </div>
              <p class="text-[11px] text-[var(--muted)]">Saved /src/module-3.cpp.</p>
              <div class="text-[10px] text-[var(--muted)] opacity-75 font-mono">07:57 PM • 10/27/2026</div>
            </div>

            <!-- Event 4 -->
            <div class="p-3 rounded-xl border space-y-1" style="background: var(--panel-background); border-color: var(--border);">
              <div class="flex items-center justify-between">
                <span class="font-bold text-[var(--text-strong)]">File saved</span>
                <span class="text-[9px] font-mono px-1.5 py-0.5 rounded uppercase" style="background: var(--accent-soft); color: var(--accent);">WORKSPACE</span>
              </div>
              <p class="text-[11px] text-[var(--muted)]">Saved /src/module-3.cpp.</p>
              <div class="text-[10px] text-[var(--muted)] opacity-75 font-mono">07:57 PM • 10/27/2026</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>

<script>
  function togglePasswordVisibility() {
    var pwd = document.getElementById('prof-password');
    var btn = document.getElementById('btn-toggle-pwd');
    if (!pwd || !btn) return;
    if (pwd.type === 'password') {
      pwd.type = 'text';
      pwd.value = 'LocalSecretAccessKey2026';
      btn.textContent = 'Hide';
    } else {
      pwd.type = 'password';
      pwd.value = '••••••••••••';
      btn.textContent = 'Show';
    }
  }

  function saveFullProfileChanges() {
    var username = (document.getElementById('prof-username').value || '').trim() || 'Alex';
    var bio = (document.getElementById('prof-bio').value || '').trim();
    var email = (document.getElementById('prof-email').value || '').trim() || (username + '@local.dev');

    window.voidlabSaveProfile(username, bio, true);
    var heroEmail = document.getElementById('profile-hero-email');
    if (heroEmail) heroEmail.textContent = email;

    alert('Profile changes saved successfully to local storage!');
  }
</script>
{{end}}
