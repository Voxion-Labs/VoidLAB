{{define "editor"}}
<div
  id="editor-pane"
  class="flex-1 min-w-[320px] flex flex-col h-full overflow-hidden relative"
  style="background: var(--background-main);"
>
  <!-- ── Top Buffer Tab Bar (1:1 with EditorTabs.tsx) ── -->
  <div
    class="h-9 flex items-center justify-between px-1 shrink-0 select-none font-sans text-xs overflow-x-auto scrollbar-thin transition-colors"
    style="background: var(--surface-soft); border-bottom: 1px solid var(--border);"
  >
    <!-- Left: Open Tabs List -->
    <div id="editor-tabs-list" class="flex items-center gap-0.5 h-full">
      {{if .OpenTabs}}
        {{range .OpenTabs}}
          <div
            class="h-full px-3 flex items-center gap-2 text-xs cursor-pointer transition-colors duration-100 {{if .IsActive}}font-semibold{{else}}opacity-75 hover:opacity-100 hover:bg-[var(--control-hover)]{{end}}"
            style="background: {{if .IsActive}}var(--panel-background){{else}}transparent{{end}}; border-right: 1px solid var(--border); border-top: {{if .IsActive}}2px solid var(--accent){{else}}2px solid transparent{{end}}; color: {{if .IsActive}}var(--text-strong){{else}}var(--muted){{end}};"
            hx-get="/api/files/open?path={{.Path}}"
            hx-target="#main-editor-pane"
            hx-swap="innerHTML"
          >
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: {{if .IsActive}}var(--accent){{else}}var(--muted){{end}};">
              <polyline points="16 18 22 12 16 6"></polyline>
              <polyline points="8 6 2 12 8 18"></polyline>
            </svg>
            <span class="truncate max-w-[150px]">{{.Name}}</span>
            <button
              class="rounded p-0.5 opacity-50 hover:opacity-100 hover:bg-[var(--control-hover)] transition-all ml-0.5 cursor-pointer"
              hx-delete="/api/files/close?path={{.Path}}"
              hx-target="#main-editor-pane"
              hx-swap="innerHTML"
              title="Close {{.Name}}"
              type="button"
              onclick="event.stopPropagation();"
            >
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>
          </div>
        {{end}}
      {{else}}
        <!-- Default Active Tab -->
        <div
          class="h-full px-3 flex items-center gap-2 text-xs cursor-pointer transition-colors duration-100 font-semibold"
          style="background: var(--panel-background); border-right: 1px solid var(--border); border-top: 2px solid var(--accent); color: var(--text-strong);"
        >
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--accent);">
            <polyline points="16 18 22 12 16 6"></polyline>
            <polyline points="8 6 2 12 8 18"></polyline>
          </svg>
          <span class="truncate max-w-[150px]">{{if .ActiveFile}}{{.ActiveFile.Name}}{{else}}main.py{{end}}</span>
          <button
            class="rounded p-0.5 opacity-50 hover:opacity-100 hover:bg-[var(--control-hover)] transition-all ml-0.5 cursor-pointer"
            title="Close Tab"
            type="button"
          >
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>
      {{end}}
    </div>

    <!-- Right: Quick Actions & Language Metadata -->
    <div class="flex items-center gap-2 text-xs font-sans px-2 shrink-0" style="color: var(--muted);">
      <!-- Format Code Button (WASM Powered) -->
      <button
        onclick="voidlabFormatCode()"
        class="px-2 py-0.5 hover:text-[var(--text-strong)] hover:bg-[var(--control-hover)] rounded transition-colors flex items-center gap-1.5 cursor-pointer"
        title="Format active file (WebAssembly powered)"
        type="button"
      >
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="21" y1="10" x2="7" y2="10"></line>
          <line x1="21" y1="6" x2="3" y2="6"></line>
          <line x1="21" y1="14" x2="3" y2="14"></line>
          <line x1="21" y1="18" x2="7" y2="18"></line>
        </svg>
        <span class="hidden sm:inline">Format</span>
      </button>

      <!-- Boilerplate Generator -->
      <button
        hx-post="/api/code/boilerplate"
        hx-target="#code-editor"
        hx-swap="outerHTML"
        class="px-2 py-0.5 hover:text-[var(--text-strong)] hover:bg-[var(--control-hover)] rounded transition-colors flex items-center gap-1.5 cursor-pointer"
        title="Insert fresh boilerplate for active language"
        type="button"
      >
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"></path>
        </svg>
        <span class="hidden sm:inline">Boilerplate</span>
      </button>

      <a
        href="/api/files/download"
        class="px-2 py-0.5 hover:text-[var(--text-strong)] hover:bg-[var(--control-hover)] rounded transition-colors flex items-center gap-1.5"
        title="Download active file"
      >
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        <span class="hidden sm:inline">Export</span>
      </a>

      <span class="opacity-30">|</span>
      <!-- WebAssembly Client Engine Status Badge -->
      <span id="wasm-badge" class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[10px] font-mono" style="background: var(--control-background); border: 1px solid var(--border); color: var(--muted);" title="Client-Side WebAssembly Engine">
        <span id="wasm-dot" class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
        <span id="wasm-status-text">WASM</span>
      </span>
      <span class="opacity-30">|</span>
      <span id="wasm-syntax-indicator" class="font-mono text-[11px] text-emerald-500" title="Instant Client-Side Syntax Validation">Valid</span>
      <span class="opacity-30">|</span>
      <span id="wasm-metrics-lines" class="font-mono text-[11px]">0L</span>
      <span class="opacity-30">|</span>
      <span class="font-mono text-[11px]">{{if .ActiveFile}}{{.ActiveFile.LanguageLabel}}{{else}}Python{{end}}</span>
      <span class="opacity-30">|</span>
      <span class="font-mono text-[11px]">UTF-8</span>
    </div>
  </div>

  <!-- ── Editor Code Canvas (Monaco Style / Textarea) ── -->
  <div id="monaco-editor-container" class="flex-1 h-full min-h-0 relative flex bg-[var(--background-main)] overflow-hidden">
    <!-- Line Numbers Gutter -->
    <div id="editor-gutter" class="w-12 py-3 pr-4 text-right text-xs font-mono select-none opacity-40 leading-6 border-r border-[var(--border)] shrink-0 overflow-hidden">
      <div>1</div>
    </div>

    <!-- Editable Code Surface / Textarea -->
    <textarea
      id="code-editor"
      name="content"
      data-active-path="{{if .ActiveFile}}{{.ActiveFile.Path}}{{end}}"
      data-active-lang="{{if .ActiveFile}}{{.ActiveFile.LanguageLabel}}{{end}}"
      hx-post="/api/files/save"
      hx-trigger="keyup changed delay:1000ms"
      hx-target="#status-message"
      hx-swap="innerHTML"
      spellcheck="false"
      class="flex-1 h-full p-3 font-mono text-xs leading-6 bg-transparent outline-none resize-none scrollbar-thin transition-colors"
      style="color: var(--text);"
      placeholder="# Write code here or select a file..."
      oninput="voidlabHandleEditorInput(this)"
      onscroll="voidlabSyncGutterScroll(this)"
      onkeydown="voidlabHandleEditorKeydown(event, this)"
    >{{if .ActiveFile}}{{.ActiveFile.Content}}{{else}}# VoidLAB - Local-First Cloud IDE
# Sub-millisecond execution engine (Go + HTMX + WASM)

def main():
    print("Welcome to VoidLAB 2.0")

if __name__ == "__main__":
    main()
{{end}}</textarea>
  </div>

  <!-- Instant Client-Side Syntax Alert Bar (WASM Powered) -->
  <div
    id="wasm-syntax-banner"
    class="hidden px-3 py-1 text-xs font-mono flex items-center justify-between border-t transition-colors shrink-0"
    style="background: rgba(239, 68, 68, 0.08); border-color: rgba(239, 68, 68, 0.2); color: #ef4444;"
  >
    <div class="flex items-center gap-2">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="8" x2="12" y2="12"></line>
        <line x1="12" y1="16" x2="12.01" y2="16"></line>
      </svg>
      <span id="wasm-syntax-error-text">Syntax alert detected</span>
    </div>
    <span id="wasm-syntax-pos" class="text-[10px] opacity-80 font-mono"></span>
  </div>

  <script>
    (function() {
      var path = "{{if .ActiveFile}}{{.ActiveFile.Path}}{{end}}";
      var lang = "{{if .ActiveFile}}{{.ActiveFile.LanguageLabel}}{{end}}";
      var tagPath = document.getElementById('active-file-tag-path');
      var tagLang = document.getElementById('active-file-tag-lang');
      if (tagPath && path) tagPath.innerText = path;
      if (tagLang && lang) tagLang.innerText = lang;

      var editor = document.getElementById('code-editor');
      if (editor) {
        if (window.voidlabUpdateGutter) window.voidlabUpdateGutter(editor);
        if (window.voidlabValidateCode) window.voidlabValidateCode(editor.value, lang);
      }
    })();
  </script>
</div>
{{end}}

{{define "editor-page"}}
<main
  class="min-h-screen w-full flex flex-col font-sans select-none antialiased transition-colors"
  style="background: var(--background-main); color: var(--text);"
>
  <!-- ========================================================================= -->
  <!-- 1. TOP NAVBAR (with Logout button, Sub-views & quick actions)              -->
  <!-- ========================================================================= -->
  {{template "topbar" .}}

  <!-- ========================================================================= -->
  <!-- 2. MAIN WORKSPACE (3-Column Layout: Explorer, Main Editor Pane, Terminal)  -->
  <!-- ========================================================================= -->
  <div
    id="editor-workspace"
    class="flex-1 flex flex-col lg:flex-row overflow-y-auto lg:overflow-hidden min-h-[640px] relative transition-colors"
    style="background: var(--background-main);"
  >
    <!-- Left Column: File Explorer (explorer.tmpl) -->
    {{template "explorer" .}}

    <!-- Divider 1: Left Splitter (between Explorer & Editor) -->
    <div
      class="w-1 hover:w-1.5 cursor-col-resize transition-all duration-100 z-20 flex flex-col items-center justify-center group shrink-0"
      style="background: var(--border);"
      title="Drag to resize explorer"
    >
      <div
        class="h-6 w-[1.5px] rounded-full group-hover:scale-125 transition-transform"
        style="background: var(--muted);"
      ></div>
    </div>

    <!-- Middle Column: Main Code Editor Host (Target for AI, Collab, Profile, Editor) -->
    <div
      id="main-editor-pane"
      class="flex-1 min-w-[320px] flex flex-col h-full overflow-hidden relative"
      style="background: var(--background-main);"
    >
      {{template "editor" .}}
    </div>

    <!-- Divider 2: Right Splitter (between Editor & Terminal) -->
    <div
      class="w-1 hover:w-1.5 cursor-col-resize transition-all duration-100 z-20 flex flex-col items-center justify-center group shrink-0"
      style="background: var(--border);"
      title="Drag to resize terminal"
    >
      <div
        class="h-6 w-[1.5px] rounded-full group-hover:scale-125 transition-transform"
        style="background: var(--muted);"
      ></div>
    </div>

    <!-- Right Column: Interactive xterm.js Terminal & Output (terminal.tmpl) -->
    {{template "terminal" .}}
  </div>
</main>

<!-- Client-Side Vanilla JS Logic: WASM Loading, Gutter Sync, Shortcuts, Theme -->
<script>
  // 1. Run Trigger
  function handleVoidLabRun(e) {
    if (e) e.preventDefault();
    var tag = document.getElementById('active-file-tag-path');
    var path = tag ? tag.innerText.trim() : '';
    if (!path) {
      var editor = document.getElementById('code-editor');
      path = editor ? (editor.getAttribute('data-active-path') || '') : '';
    }
    var lower = (path || '').toLowerCase();
    if (lower.endsWith('.html') || lower.endsWith('.htm') || lower.endsWith('.css')) {
      window.open('/preview?path=' + encodeURIComponent(path), '_blank');
      if (window.voidlabSwitchTab) {
        window.voidlabSwitchTab('terminal');
      }
      return;
    }
    if (window.voidlabRun) {
      window.voidlabRun(path);
    }
  }

  // 2. Manual Save Trigger
  function voidlabTriggerManualSave() {
    var editor = document.getElementById('code-editor');
    if (!editor) return;
    var content = editor.value;
    var status = document.getElementById('status-message');
    if (status) status.innerText = 'Saving...';
    htmx.ajax('POST', '/api/files/save', {
      values: { content: content },
      target: '#status-message',
      swap: 'innerHTML'
    });
  }

  // 3. Line Number Gutter Synchronization
  function voidlabUpdateGutter(editor) {
    if (!editor) editor = document.getElementById('code-editor');
    if (!editor) return;
    var gutter = document.getElementById('editor-gutter');
    if (!gutter) return;

    var lines = (editor.value || '').split('\n').length;
    var currentLines = gutter.children.length;

    if (currentLines !== lines) {
      var fragment = document.createDocumentFragment();
      for (var i = 1; i <= lines; i++) {
        var div = document.createElement('div');
        div.textContent = i;
        fragment.appendChild(div);
      }
      gutter.innerHTML = '';
      gutter.appendChild(fragment);
    }

    var metricLines = document.getElementById('wasm-metrics-lines');
    if (metricLines) metricLines.textContent = lines + 'L';
  }

  function voidlabSyncGutterScroll(editor) {
    var gutter = document.getElementById('editor-gutter');
    if (gutter && editor) {
      gutter.scrollTop = editor.scrollTop;
    }
  }

  function voidlabHandleEditorInput(editor) {
    voidlabUpdateGutter(editor);
    var lang = editor.getAttribute('data-active-lang') || 'python';
    voidlabValidateCode(editor.value, lang);
  }

  function voidlabHandleEditorKeydown(e, editor) {
    // Tab key: insert 2 spaces
    if (e.key === 'Tab') {
      e.preventDefault();
      var start = editor.selectionStart;
      var end = editor.selectionEnd;
      editor.value = editor.value.substring(0, start) + '  ' + editor.value.substring(end);
      editor.selectionStart = editor.selectionEnd = start + 2;
      voidlabHandleEditorInput(editor);
      return;
    }
    // Ctrl+S: Save file
    if ((e.ctrlKey || e.metaKey) && e.key === 's') {
      e.preventDefault();
      voidlabTriggerManualSave();
      return;
    }
    // Ctrl+Enter: Run code
    if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
      e.preventDefault();
      handleVoidLabRun(e);
      return;
    }
  }

  // 4. WebAssembly Instant Client-Side Syntax Validation & Format
  function voidlabValidateCode(code, lang) {
    if (!window.voidlabWASM || !window.voidlabWASM.validate) return;
    try {
      var res = window.voidlabWASM.validate(code, lang);
      if (typeof res === 'string') res = JSON.parse(res);
      var banner = document.getElementById('wasm-syntax-banner');
      var ind = document.getElementById('wasm-syntax-indicator');
      var errText = document.getElementById('wasm-syntax-error-text');
      var errPos = document.getElementById('wasm-syntax-pos');

      if (res && !res.valid) {
        if (banner) banner.classList.remove('hidden');
        if (ind) {
          ind.textContent = 'Alert';
          ind.className = 'font-mono text-[11px] text-rose-500 font-bold';
        }
        if (errText) errText.textContent = res.message || 'Syntax error';
        if (errPos && res.line) errPos.textContent = 'Line ' + res.line + (res.column ? (':' + res.column) : '');
      } else {
        if (banner) banner.classList.add('hidden');
        if (ind) {
          ind.textContent = 'Valid';
          ind.className = 'font-mono text-[11px] text-emerald-500';
        }
      }
    } catch (_) {}
  }

  function voidlabFormatCode() {
    var editor = document.getElementById('code-editor');
    if (!editor) return;
    var lang = editor.getAttribute('data-active-lang') || 'python';
    if (window.voidlabWASM && window.voidlabWASM.format) {
      try {
        var formatted = window.voidlabWASM.format(editor.value, lang);
        if (formatted) {
          editor.value = formatted;
          voidlabHandleEditorInput(editor);
          voidlabTriggerManualSave();
        }
      } catch (_) {}
    }
  }

  // 5. Asynchronous WebAssembly Engine Loading (Non-Blocking)
  (function() {
    function loadWASM() {
      if (window._voidlabWASMLoaded) return;
      window._voidlabWASMLoaded = true;

      const wasmScript = document.createElement('script');
      wasmScript.src = '/public/wasm/wasm_exec.js';
      wasmScript.async = true;
      wasmScript.onload = function() {
        if (typeof Go === 'undefined') return;
        const go = new Go();
        const instantiate = WebAssembly.instantiateStreaming
          ? WebAssembly.instantiateStreaming(fetch('/public/wasm/voidlab.wasm'), go.importObject)
          : fetch('/public/wasm/voidlab.wasm').then(res => res.arrayBuffer()).then(bytes => WebAssembly.instantiate(bytes, go.importObject));

        instantiate.then(result => {
          go.run(result.instance);
          const badgeDot = document.getElementById('wasm-dot');
          const badgeText = document.getElementById('wasm-status-text');
          if (badgeDot) badgeDot.className = 'w-1.5 h-1.5 rounded-full bg-emerald-400';
          if (badgeText) badgeText.textContent = 'WASM Ready';

          var editor = document.getElementById('code-editor');
          if (editor) {
            voidlabUpdateGutter(editor);
            voidlabValidateCode(editor.value, editor.getAttribute('data-active-lang') || 'python');
          }
        }).catch(err => {
          console.warn('[VoidLAB WASM] initialization deferred:', err);
        });
      };
      document.body.appendChild(wasmScript);
    }

    if (document.readyState === 'complete') {
      loadWASM();
    } else {
      window.addEventListener('load', loadWASM);
    }
  })();

  // 6. Theme Switcher (Dark / Light)
  function toggleVoidLabTheme() {
    const html = document.documentElement;
    const current = html.getAttribute('data-theme') || 'light';
    const next = current === 'dark' ? 'light' : 'dark';
    html.setAttribute('data-theme', next);
    try { localStorage.setItem('voidlab-theme', next); } catch (e) {}
    updateThemeUI(next);
  }

  function updateThemeUI(theme) {
    const isDark = theme === 'dark';
    const sun = document.getElementById('theme-icon-sun');
    const moon = document.getElementById('theme-icon-moon');
    const label = document.getElementById('theme-label');
    if (sun && moon) {
      if (isDark) {
        sun.classList.remove('hidden');
        moon.classList.add('hidden');
        if (label) label.innerText = 'Light';
      } else {
        sun.classList.add('hidden');
        moon.classList.remove('hidden');
        if (label) label.innerText = 'Dark';
      }
    }
  }

  // Restore theme on mount
  (function() {
    try {
      const savedTheme = localStorage.getItem('voidlab-theme') || 'light';
      document.documentElement.setAttribute('data-theme', savedTheme);
      updateThemeUI(savedTheme);
    } catch (e) {}
  })();
</script>
{{end}}

{{define "editor.tmpl"}}
{{template "base.tmpl" .}}
{{end}}
