{{define "github"}}
<!-- Fragment compatibility for side-panel or dynamic swaps -->
<div id="github-view" class="flex-1 flex flex-col h-full overflow-hidden select-none font-sans transition-colors" style="background: var(--background-main); color: var(--text);">
  <div class="h-10 px-4 flex items-center justify-between shrink-0 border-b select-none transition-colors" style="background: var(--surface-soft); border-color: var(--border);">
    <div class="flex items-center gap-2">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--accent);"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
      <span class="font-bold tracking-tight text-xs text-[var(--text-strong)]">GitHub Sync & Version Control</span>
    </div>
    <a href="/editor/github" class="text-xs px-2.5 py-1 rounded bg-[var(--control-background)] hover:bg-[var(--control-hover)] border border-[var(--border)] text-[var(--text)] transition cursor-pointer">
      Open Full Page ↗
    </a>
  </div>
  <div class="p-4 text-xs text-[var(--muted)] space-y-2">
    <div class="font-bold text-[var(--text-strong)]">Git Command Cheatsheet</div>
    <p>Sync your local workspace with remote GitHub repositories.</p>
  </div>
</div>
{{end}}

{{define "github-page"}}
<main class="min-h-screen w-full flex flex-col font-sans select-none antialiased transition-colors" style="background: var(--background-main); color: var(--text);">
  <!-- Universal Tool Header (← Back, VoidLAB Logo, Theme, Profile, Logout) -->
  {{template "tool-header" .}}

  <!-- Main GitHub Sync Content Container -->
  <div class="w-full max-w-6xl mx-auto px-4 sm:px-6 pb-12">
    <!-- Category Badge -->
    <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-[11px] font-bold uppercase tracking-wider mb-2.5" style="background: var(--accent-soft); color: var(--accent);">
      VERSION CONTROL
    </div>

    <!-- Page Title & Subtitle -->
    <h1 class="text-3xl font-extrabold tracking-tight display-font text-[var(--text-strong)] mb-2">
      GitHub Sync & Publishing
    </h1>
    <p class="text-xs sm:text-sm text-[var(--muted)] max-w-3xl leading-relaxed mb-6">
      Publish your local-first workspace directly to remote Git repositories, stage changes, and synchronize branches without leaving the browser.
    </p>

    <!-- 2-Column Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      <!-- Left Column: Remote Configuration & Command Generator -->
      <div class="lg:col-span-7 space-y-6">
        <!-- Card: Remote Publishing -->
        <div class="rounded-2xl border p-5 sm:p-6 shadow-sm transition-colors space-y-4" style="background: var(--surface-soft); border-color: var(--border);">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2 text-xs font-bold text-[var(--text-strong)]">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--accent);"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
              <span>Repository Remote Setup</span>
            </div>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded" style="background: var(--control-background); color: var(--muted);">Git CLI Ready</span>
          </div>

          <div class="space-y-3 pt-1">
            <div>
              <label class="block text-[11px] font-semibold text-[var(--muted)] mb-1">Remote Repository URL</label>
              <input
                id="gh-repo-url"
                type="text"
                value="https://github.com/Voxion-Labs/VoidLAB.git"
                class="w-full px-3.5 py-2.5 rounded-xl text-xs font-mono outline-none transition-colors"
                style="background: var(--input-background); border: 1px solid var(--border); color: var(--text);"
                oninput="updateGitSnippet()"
              />
            </div>
            <div>
              <label class="block text-[11px] font-semibold text-[var(--muted)] mb-1">Branch Name</label>
              <input
                id="gh-branch-name"
                type="text"
                value="main"
                class="w-full px-3.5 py-2.5 rounded-xl text-xs font-mono outline-none transition-colors"
                style="background: var(--input-background); border: 1px solid var(--border); color: var(--text);"
                oninput="updateGitSnippet()"
              />
            </div>
          </div>

          <!-- Generated Command Snippet -->
          <div class="p-3.5 rounded-xl border relative font-mono text-xs space-y-2" style="background: var(--panel-background); border-color: var(--border);">
            <div class="flex items-center justify-between text-[11px] text-[var(--muted)] pb-1 border-b" style="border-color: var(--border);">
              <span>Run in VoidLAB Terminal:</span>
              <button
                type="button"
                onclick="copyGitSnippet()"
                class="px-2 py-0.5 rounded text-[10px] border transition-colors hover:bg-[var(--control-hover)] cursor-pointer"
                style="background: var(--control-background); border-color: var(--border); color: var(--text-strong);"
              >
                Copy
              </button>
            </div>
            <pre id="gh-cmd-snippet" class="whitespace-pre-wrap leading-relaxed text-[var(--text-strong)] text-[11px]">git init
git add .
git commit -m "feat: ship local workspace from VoidLAB"
git remote add origin https://github.com/Voxion-Labs/VoidLAB.git
git push -u origin main</pre>
          </div>
        </div>
      </div>

      <!-- Right Column: Git Command Reference -->
      <div class="lg:col-span-5 space-y-4">
        <div class="rounded-2xl border p-5 sm:p-6 shadow-sm transition-colors space-y-3" style="background: var(--surface-soft); border-color: var(--border);">
          <div class="text-xs font-bold text-[var(--text-strong)] pb-1">Essential Git Commands</div>
          <div class="space-y-2.5 text-xs">
            <div class="p-2.5 rounded-lg border" style="background: var(--panel-background); border-color: var(--border);">
              <code class="font-bold text-[var(--accent)] text-[11px]">git status</code>
              <p class="text-[10px] text-[var(--muted)] mt-0.5">Show tracked and untracked file status in current workspace.</p>
            </div>
            <div class="p-2.5 rounded-lg border" style="background: var(--panel-background); border-color: var(--border);">
              <code class="font-bold text-[var(--accent)] text-[11px]">git diff</code>
              <p class="text-[10px] text-[var(--muted)] mt-0.5">View unstaged file modifications across local buffers.</p>
            </div>
            <div class="p-2.5 rounded-lg border" style="background: var(--panel-background); border-color: var(--border);">
              <code class="font-bold text-[var(--accent)] text-[11px]">git pull origin main</code>
              <p class="text-[10px] text-[var(--muted)] mt-0.5">Fetch and integrate remote changes into your local branch.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>

<script>
  function updateGitSnippet() {
    var url = (document.getElementById('gh-repo-url').value || '').trim() || 'https://github.com/Voxion-Labs/VoidLAB.git';
    var branch = (document.getElementById('gh-branch-name').value || '').trim() || 'main';
    var snippet = 'git init\n' +
      'git add .\n' +
      'git commit -m "feat: ship local workspace from VoidLAB"\n' +
      'git remote add origin ' + url + '\n' +
      'git push -u origin ' + branch;
    var el = document.getElementById('gh-cmd-snippet');
    if (el) el.textContent = snippet;
  }

  function copyGitSnippet() {
    var el = document.getElementById('gh-cmd-snippet');
    if (el) {
      navigator.clipboard.writeText(el.textContent);
      alert('Git commands copied to clipboard!');
    }
  }
</script>
{{end}}
