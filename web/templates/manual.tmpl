{{define "manual"}}
<!-- Fragment compatibility for side-panel or dynamic swaps -->
<div id="manual-view" class="flex-1 flex flex-col h-full overflow-hidden select-none font-sans transition-colors" style="background: var(--background-main); color: var(--text);">
  <div class="h-10 px-4 flex items-center justify-between shrink-0 border-b select-none transition-colors" style="background: var(--surface-soft); border-color: var(--border);">
    <div class="flex items-center gap-2">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--accent);"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
      <span class="font-bold tracking-tight text-xs text-[var(--text-strong)]">Operator Manual</span>
    </div>
    <a href="/editor/manual" class="text-xs px-2.5 py-1 rounded bg-[var(--control-background)] hover:bg-[var(--control-hover)] border border-[var(--border)] text-[var(--text)] transition cursor-pointer">
      Open Full Page ↗
    </a>
  </div>
  <div class="p-4 text-xs text-[var(--muted)]">
    Explore the full Operator Handbook with architecture blueprints, runtime flows, and command references.
  </div>
</div>
{{end}}

{{define "manual-page"}}
<main class="min-h-screen w-full flex flex-col font-sans select-none antialiased transition-colors" style="background: var(--background-main); color: var(--text);">
  <!-- Universal Tool Header (← Back, VoidLAB Logo, Theme, Profile, Logout) -->
  {{template "tool-header" .}}

  <!-- Main Manual Container (Exact 1:1 with Screenshot 1) -->
  <div class="w-full max-w-6xl mx-auto px-4 sm:px-6 pb-12">
    <!-- Category Badge -->
    <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-[11px] font-bold uppercase tracking-wider mb-2.5" style="background: var(--accent-soft); color: var(--accent);">
      ILLUSTRATED HANDBOOK
    </div>

    <!-- Page Title & Subtitle -->
    <h1 class="text-3xl font-extrabold tracking-tight display-font text-[var(--text-strong)] mb-2">
      VoidLAB operator manual
    </h1>
    <p class="text-xs sm:text-sm text-[var(--muted)] max-w-3xl leading-relaxed mb-6">
      Read the illustrated operator handbook for the current VoidLAB release: workspace anatomy, unified console behavior, inline stdin flow, tool pages, commands, and deploy-ready habits.
    </p>

    <!-- Main Handbook Outer Box (Exact 1:1 with Screenshot 1) -->
    <div class="rounded-2xl border shadow-sm overflow-hidden grid grid-cols-1 lg:grid-cols-12 transition-colors" style="border-color: var(--border); background: var(--surface-soft);">
      <!-- Left Sidebar Navigation (4 cols) -->
      <div class="lg:col-span-4 p-5 sm:p-6 border-b lg:border-b-0 lg:border-r space-y-6" style="border-color: var(--border);">
        <!-- Operator Handbook Badge Card -->
        <div class="p-4 rounded-xl border space-y-2" style="background: var(--accent-soft); border-color: var(--border-strong);">
          <div class="flex items-center gap-2 text-xs font-bold" style="color: var(--accent);">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
            <span>Operator handbook</span>
          </div>
          <p class="text-xs text-[var(--text)] leading-relaxed">
            An illustrated field guide for the current VoidLAB workspace, execution flow, tool pages, and deploy-ready habits.
          </p>
        </div>

        <!-- Contents Navigation Section -->
        <div class="space-y-2">
          <div class="text-[10px] font-bold uppercase tracking-widest text-[var(--muted)] px-1">
            CONTENTS
          </div>
          <nav class="space-y-1 text-xs font-medium">
            <a href="#manual-overview" class="flex items-center justify-between p-2.5 rounded-lg border transition-colors hover:bg-[var(--control-hover)]" style="background: var(--panel-background); border-color: var(--border); color: var(--text-strong);">
              <span>Overview</span>
              <span class="text-[var(--muted)]">/</span>
            </a>
            <a href="#manual-map" class="flex items-center justify-between p-2.5 rounded-lg border transition-colors hover:bg-[var(--control-hover)]" style="background: var(--panel-background); border-color: var(--border); color: var(--text);">
              <span>Workspace Map</span>
              <span class="text-[var(--muted)]">/</span>
            </a>
            <a href="#manual-flow" class="flex items-center justify-between p-2.5 rounded-lg border transition-colors hover:bg-[var(--control-hover)]" style="background: var(--panel-background); border-color: var(--border); color: var(--text);">
              <span>Execution Flow</span>
              <span class="text-[var(--muted)]">/</span>
            </a>
            <a href="#manual-console" class="flex items-center justify-between p-2.5 rounded-lg border transition-colors hover:bg-[var(--control-hover)]" style="background: var(--panel-background); border-color: var(--border); color: var(--text);">
              <span>Unified Console</span>
              <span class="text-[var(--muted)]">/</span>
            </a>
            <a href="#manual-commands" class="flex items-center justify-between p-2.5 rounded-lg border transition-colors hover:bg-[var(--control-hover)]" style="background: var(--panel-background); border-color: var(--border); color: var(--text);">
              <span>Workspace Commands</span>
              <span class="text-[var(--muted)]">/</span>
            </a>
            <a href="#manual-tools" class="flex items-center justify-between p-2.5 rounded-lg border transition-colors hover:bg-[var(--control-hover)]" style="background: var(--panel-background); border-color: var(--border); color: var(--text);">
              <span>Tool Hub</span>
              <span class="text-[var(--muted)]">/</span>
            </a>
          </nav>
        </div>
      </div>

      <!-- Right Main Content Panel (8 cols) -->
      <div class="lg:col-span-8 p-6 sm:p-8 space-y-6" style="background: var(--panel-background);">
        <!-- System Overview Section (Exact 1:1 with Screenshot 1) -->
        <section id="manual-overview" class="space-y-4">
          <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-[11px] font-semibold uppercase tracking-wider" style="background: var(--accent-soft); color: var(--accent);">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
            <span>SYSTEM OVERVIEW</span>
          </div>

          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight display-font text-[var(--text-strong)]">
            VoidLAB Operator Handbook
          </h2>

          <p class="text-xs sm:text-sm text-[var(--muted)] leading-relaxed">
            VoidLAB is a modern browser-based coding workspace built around an editor, a multi-file project model, a unified execution console, and focused tool pages for publishing, collaboration, AI guidance, and profile management.
          </p>

          <!-- Model Cards (Exact 1:1 with Screenshot 1) -->
          <div class="space-y-3 pt-2">
            <div class="p-4 rounded-xl border" style="background: var(--surface-soft); border-color: var(--border);">
              <div class="text-[10px] font-bold uppercase tracking-wider text-[var(--muted)]">EDITOR MODEL</div>
              <div class="text-sm font-bold text-[var(--text-strong)] mt-1">Multi-file local workspace</div>
            </div>

            <div class="p-4 rounded-xl border" style="background: var(--surface-soft); border-color: var(--border);">
              <div class="text-[10px] font-bold uppercase tracking-wider text-[var(--muted)]">RUNTIME MODEL</div>
              <div class="text-sm font-bold text-[var(--text-strong)] mt-1">Judge0-backed execution + preview</div>
            </div>
          </div>

          <!-- Lower Summary Cards (Exact 1:1 with Screenshot 1) -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
            <div class="p-4 rounded-xl border text-xs font-semibold text-[var(--text-strong)]" style="background: var(--surface-soft); border-color: var(--border);">
              Browser-based IDE with multi-file workspace and live execution
            </div>
            <div class="p-4 rounded-xl border text-xs font-semibold text-[var(--text-strong)]" style="background: var(--surface-soft); border-color: var(--border);">
              Unified console with Output, Terminal, and Ports tabs
            </div>
          </div>
        </section>

        <!-- Detailed Handbook Sections -->
        <section id="manual-map" class="space-y-3 pt-4 border-t" style="border-color: var(--border);">
          <h3 class="text-base font-bold text-[var(--text-strong)]">Workspace Anatomy & VFS</h3>
          <p class="text-xs text-[var(--muted)] leading-relaxed">
            The workspace maintains zero external database state. All source files, folder trees, and editor buffers are stored directly in your browser's local Virtual File System (VFS). When triggering a build or execution, files are streamed to the containerized runner in real-time.
          </p>
        </section>

        <section id="manual-flow" class="space-y-3 pt-4 border-t" style="border-color: var(--border);">
          <h3 class="text-base font-bold text-[var(--text-strong)]">Execution Flow & Ephemeral Sandboxes</h3>
          <p class="text-xs text-[var(--muted)] leading-relaxed">
            VoidLAB dispatches code to isolated runtime containers with strict security constraints (256MB memory cap, 0.5 CPU limit). Containers run with the <code>--rm</code> flag and vanish immediately when execution completes.
          </p>
        </section>

        <section id="manual-console" class="space-y-3 pt-4 border-t" style="border-color: var(--border);">
          <h3 class="text-base font-bold text-[var(--text-strong)]">Unified Console</h3>
          <p class="text-xs text-[var(--muted)] leading-relaxed">
            Switch smoothly between <strong>Terminal</strong> (live xterm.js sandbox shell), <strong>Output</strong> (compiler logs, stdout/stderr streams, execution duration), and <strong>Ports</strong> (network preview).
          </p>
        </section>
      </div>
    </div>
  </div>
</main>
{{end}}
