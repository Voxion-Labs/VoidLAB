{{define "index"}}
<main
  class="min-h-screen w-full flex flex-col font-sans select-none antialiased transition-colors"
  style="background: var(--background-main); color: var(--text);"
>
  <!-- ========================================================================= -->
  <!-- 1. TOP NAVBAR (1:1 Replica from Next.js src/app/editor/page.tsx)          -->
  <!-- ========================================================================= -->
  <header
    class="h-12 shrink-0 px-4 flex items-center justify-between z-30 relative select-none transition-colors border-b"
    style="background: var(--panel-background); border-color: var(--border);"
  >
    <!-- Left: Brand Logo & File Path & Run Trigger -->
    <div class="flex items-center gap-3">
      <!-- Brand Logo (1:1 with Brand.tsx) -->
      <a
        href="/"
        class="flex items-center gap-2.5 group transition-opacity opacity-90 hover:opacity-100"
        title="VoidLAB Home"
      >
        <svg
          width="28"
          height="28"
          viewBox="0 0 128 128"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          class="flex-shrink-0"
          style="color: var(--text-strong);"
          aria-hidden="true"
        >
          <path d="M18 10 L54 110 L64 90 L36 10 Z" fill="currentColor" />
          <path d="M110 10 L74 110 L64 90 L92 10 Z" fill="currentColor" />
          <path d="M80 8 L44 122" stroke="currentColor" stroke-width="7" stroke-linecap="round" />
        </svg>
        <div class="font-display font-bold leading-none" style="font-size: 1.1rem; letter-spacing: -0.02em; color: var(--text-strong);">
          VoidLAB
        </div>
      </a>

      <div class="h-4 w-px" style="background: var(--border);"></div>

      <!-- Active File Path Tag -->
      <div
        id="active-file-tag"
        class="flex items-center gap-2 px-2.5 py-1 rounded-md text-xs font-sans transition-colors"
        style="background: var(--surface-soft); border: 1px solid var(--border); color: var(--muted);"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0"></span>
        <span id="active-file-tag-path" class="font-medium font-sans" style="color: var(--text-strong);">
          {{if .ActiveFile}}{{.ActiveFile.Path}}{{else}}src/main.py{{end}}
        </span>
        <span style="color: var(--border);">/</span>
        <span id="active-file-tag-lang" class="font-mono text-[11px]" style="color: var(--muted);">
          {{if .ActiveFile}}{{.ActiveFile.LanguageLabel}}{{else}}Python{{end}}
        </span>
      </div>

      <!-- Action Run Pill Button -->
      <button
        id="topbar-run-btn"
        onclick="handleVoidLabRun(event)"
        hx-post="/api/code/run"
        hx-target="#terminal-stream"
        hx-swap="beforeend"
        class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-semibold rounded-md shadow-sm active:scale-[0.98] transition-all disabled:opacity-40 ml-1 cursor-pointer font-sans"
        style="background: var(--action-background); color: var(--action-foreground);"
        title="Execute script (Ctrl+Enter)"
        type="button"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
          <polygon points="5 3 19 12 5 21 5 3"></polygon>
        </svg>
        <span>Run</span>
      </button>

      <!-- Save Trigger -->
      <button
        hx-post="/api/files/save"
        hx-target="#status-message"
        hx-swap="innerHTML"
        class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-medium rounded-md transition-colors cursor-pointer font-sans"
        style="background: var(--surface-soft); border: 1px solid var(--border); color: var(--text);"
        title="Save file (Ctrl+S)"
        type="button"
      >
        <svg class="w-3.5 h-3.5 stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
          <polyline points="17 21 17 13 7 13 7 21"></polyline>
          <polyline points="7 3 7 8 15 8"></polyline>
        </svg>
        <span class="hidden sm:inline">Save</span>
      </button>

      <!-- Status Message -->
      <span
        id="status-message"
        class="text-[11px] font-sans pl-1 truncate max-w-[140px]"
        style="color: var(--muted);"
      >
        {{if .StatusMessage}}{{.StatusMessage}}{{else}}Ready{{end}}
      </span>
    </div>

    <!-- Right: Minimal Text Buttons (Manual, GitHub, Collab, AI Guide) & Theme Switcher -->
    <div class="flex items-center gap-2.5">
      <nav class="flex items-center gap-1 text-xs font-medium font-sans">
        <a
          href="/editor/manual"
          class="px-2.5 py-1 rounded-md transition-colors hover:text-[var(--text-strong)] hover:bg-[var(--surface-soft)]"
          style="color: var(--muted);"
        >
          Manual
        </a>
        <a
          href="https://github.com/Voxion-Labs/VoidLAB"
          target="_blank"
          rel="noreferrer"
          class="px-2.5 py-1 rounded-md transition-colors hover:text-[var(--text-strong)] hover:bg-[var(--surface-soft)] flex items-center gap-1"
          style="color: var(--muted);"
        >
          GitHub
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-70">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
        </a>
        <a
          href="/editor/collaboration"
          class="px-2.5 py-1 rounded-md transition-colors hover:text-[var(--text-strong)] hover:bg-[var(--surface-soft)] flex items-center gap-1.5"
          style="color: var(--muted);"
        >
          <span class="w-1.5 h-1.5 rounded-full" style="background: var(--accent);"></span>
          Collab
        </a>
        <a
          href="/editor/ai"
          class="px-2.5 py-1 rounded-md transition-colors hover:text-[var(--text-strong)] hover:bg-[var(--surface-soft)]"
          style="color: var(--muted);"
        >
          AI Guide
        </a>
      </nav>

      <div class="h-4 w-px" style="background: var(--border);"></div>

      <!-- Dual Theme Switcher (Light / Dark) -->
      <button
        id="theme-switcher-btn"
        onclick="toggleVoidLabTheme()"
        class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs select-none cursor-pointer transition-colors"
        style="background: var(--control-background); border: 1px solid var(--border); color: var(--text);"
        aria-label="Toggle theme"
        type="button"
      >
        <svg id="theme-icon-sun" class="w-3.5 h-3.5 hidden" style="color: var(--accent);" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <svg id="theme-icon-moon" class="w-3.5 h-3.5" style="color: var(--accent);" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
        <span id="theme-label" class="hidden sm:inline text-xs" style="color: var(--muted);">Dark</span>
      </button>

      <!-- Settings Trigger -->
      <button
        hx-get="/api/ui/modal/settings"
        hx-target="#modal-container"
        hx-swap="innerHTML"
        class="p-1.5 rounded-md transition-colors hover:bg-[var(--surface-soft)] cursor-pointer"
        style="color: var(--muted);"
        title="Workspace Settings (Language, Region, Shortcuts)"
        type="button"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="3"></circle>
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
        </svg>
      </button>

      <!-- User Profile Avatar -->
      <a
        href="/editor/profile"
        class="h-6 w-6 rounded-md flex items-center justify-center text-[10px] font-semibold transition-all hover:scale-105"
        style="background: var(--surface-soft); border: 1px solid var(--border); color: var(--text-strong);"
        title="Profile & Activity"
      >
        {{if .UserInitial}}{{.UserInitial}}{{else}}R{{end}}
      </a>
    </div>
  </header>

  <!-- ========================================================================= -->
  <!-- 2. MAIN WORKSPACE (3-Column Layout: Left Explorer, Middle Editor, Right Terminal) -->
  <!-- ========================================================================= -->
  <div
    id="editor-workspace"
    class="flex-1 flex flex-col lg:flex-row overflow-y-auto lg:overflow-hidden min-h-[640px] relative transition-colors"
    style="background: var(--background-main);"
  >
    <!-- ── Left Column: File Explorer Sidebar (Width: ~230px) ── -->
    {{template "sidebar" .}}

    <!-- ── Divider 1: Left Resizable Splitter (between Explorer & Editor) ── -->
    <div
      class="w-1 hover:w-1.5 cursor-col-resize transition-all duration-100 z-20 flex flex-col items-center justify-center group shrink-0"
      style="background: var(--border);"
      title="Drag to resize sidebar"
    >
      <div
        class="h-6 w-[1.5px] rounded-full group-hover:scale-125 transition-transform"
        style="background: var(--muted);"
      ></div>
    </div>

    <!-- ── Middle Column: Main Code Editor (Takes Majority Flex-1 Width) ── -->
    <div
      id="editor-pane"
      class="flex-1 min-w-[320px] flex flex-col h-full overflow-hidden relative"
      style="background: var(--background-main);"
    >
      <!-- Top Buffer Tabs & Language Actions -->
      <div
        class="h-9 shrink-0 flex items-center justify-between border-b px-2 select-none overflow-x-auto scrollbar-thin"
        style="background: var(--surface-soft); border-color: var(--border);"
      >
        <!-- Open Tabs List -->
        <div class="flex items-center h-full gap-0.5 overflow-x-auto">
          {{if .OpenTabs}}
            {{range .OpenTabs}}
              <div
                class="h-full px-3 flex items-center gap-2 text-xs cursor-pointer transition-colors duration-100 {{if .IsActive}}font-semibold{{else}}opacity-70 hover:opacity-100{{end}}"
                style="{{if .IsActive}}background: var(--panel-background); border-right: 1px solid var(--border); border-top: 2px solid var(--accent); color: var(--text-strong);{{else}}border-right: 1px solid var(--border); color: var(--muted);{{end}}"
              >
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="{{if .IsActive}}text-emerald-400{{else}}opacity-50{{end}}">
                  <polyline points="16 18 22 12 16 6"></polyline>
                  <polyline points="8 6 2 12 8 18"></polyline>
                </svg>
                <span
                  class="truncate max-w-[150px]"
                  hx-get="/api/files/open?path={{.Path}}"
                  hx-target="#editor-workspace"
                  hx-swap="outerHTML"
                >{{.Name}}</span>
                <button
                  hx-delete="/api/explorer/delete?path={{.Path}}"
                  hx-target="#editor-workspace"
                  hx-swap="outerHTML"
                  class="rounded p-0.5 opacity-50 hover:opacity-100 hover:bg-[var(--control-hover)] transition-all ml-0.5"
                  title="Close Tab"
                  type="button"
                >
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </button>
              </div>
            {{end}}
          {{else}}
            <!-- Default Active Tab -->
            <div
              class="h-full px-3 flex items-center gap-2 text-xs cursor-pointer transition-colors duration-100 font-semibold"
              style="background: var(--panel-background); border-right: 1px solid var(--border); border-top: 2px solid var(--accent); color: var(--text-strong);"
            >
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--accent);">
                <polyline points="16 18 22 12 16 6"></polyline>
                <polyline points="8 6 2 12 8 18"></polyline>
              </svg>
              <span class="truncate max-w-[150px]">{{if .ActiveFile}}{{.ActiveFile.Name}}{{else}}main.py{{end}}</span>
              <button
                class="rounded p-0.5 opacity-50 hover:opacity-100 hover:bg-[var(--control-hover)] transition-all ml-0.5"
                title="Close Tab"
                type="button"
              >
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
              </button>
            </div>
          {{end}}
        </div>

        <!-- Right: Quick Actions & Language Metadata -->
        <div class="flex items-center gap-2 text-xs font-sans px-2 shrink-0" style="color: var(--muted);">
          <!-- Format Code Button (WASM Powered) -->
          <button
            onclick="voidlabFormatCode()"
            class="px-2 py-0.5 hover:text-[var(--text-strong)] hover:bg-[var(--control-hover)] rounded transition-colors flex items-center gap-1.5 cursor-pointer"
            title="Format active file (WebAssembly powered)"
            type="button"
          >
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="21" y1="10" x2="7" y2="10"></line>
              <line x1="21" y1="6" x2="3" y2="6"></line>
              <line x1="21" y1="14" x2="3" y2="14"></line>
              <line x1="21" y1="18" x2="7" y2="18"></line>
            </svg>
            <span class="hidden sm:inline">Format</span>
          </button>

          <!-- Boilerplate Generator -->
          <button
            hx-post="/api/code/boilerplate"
            hx-target="#code-editor"
            hx-swap="outerHTML"
            class="px-2 py-0.5 hover:text-[var(--text-strong)] hover:bg-[var(--control-hover)] rounded transition-colors flex items-center gap-1.5 cursor-pointer"
            title="Insert fresh boilerplate for active language"
            type="button"
          >
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"></path>
            </svg>
            <span class="hidden sm:inline">Boilerplate</span>
          </button>

          <a
            href="/api/files/download"
            class="px-2 py-0.5 hover:text-[var(--text-strong)] hover:bg-[var(--control-hover)] rounded transition-colors flex items-center gap-1.5"
            title="Download active file"
          >
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span class="hidden sm:inline">Export</span>
          </a>

          <span class="opacity-30">|</span>
          <!-- WebAssembly Client Engine Status Badge -->
          <span id="wasm-badge" class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[10px] font-mono" style="background: var(--control-background); border: 1px solid var(--border); color: var(--muted);" title="Client-Side WebAssembly Engine">
            <span id="wasm-dot" class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            <span id="wasm-status-text">WASM</span>
          </span>
          <span class="opacity-30">|</span>
          <span id="wasm-syntax-indicator" class="font-mono text-[11px] text-emerald-500" title="Instant Client-Side Syntax Validation">Valid</span>
          <span class="opacity-30">|</span>
          <span id="wasm-metrics-lines" class="font-mono text-[11px]">0L</span>
          <span class="opacity-30">|</span>
          <span class="font-mono text-[11px]">{{if .ActiveFile}}{{.ActiveFile.LanguageLabel}}{{else}}Python{{end}}</span>
          <span class="opacity-30">|</span>
          <span class="font-mono text-[11px]">UTF-8</span>
        </div>
      </div>

      <!-- Editor Code Canvas (Monaco / WASM Mount Target) -->
      <div id="monaco-editor-container" class="flex-1 h-full min-h-0 relative flex bg-[var(--background-main)] overflow-hidden">
        <!-- Line Numbers Gutter -->
        <div id="editor-gutter" class="w-12 py-3 pr-4 text-right text-xs font-mono select-none opacity-40 leading-6 border-r border-[var(--border)] shrink-0">
          <div>1</div>
          <div>2</div>
          <div>3</div>
          <div>4</div>
          <div>5</div>
          <div>6</div>
          <div>7</div>
          <div>8</div>
          <div>9</div>
          <div>10</div>
          <div>11</div>
          <div>12</div>
        </div>

        <!-- Editable Code Surface / Textarea -->
        <textarea
          id="code-editor"
          name="content"
          data-active-path="{{if .ActiveFile}}{{.ActiveFile.Path}}{{end}}"
          hx-post="/api/files/save"
          hx-trigger="keyup changed delay:1000ms"
          hx-target="#status-message"
          hx-swap="innerHTML"
          spellcheck="false"
          class="flex-1 h-full p-3 font-mono text-xs leading-6 bg-transparent outline-none resize-none scrollbar-thin transition-colors"
          style="color: var(--text);"
          placeholder="# Write code here or select a file..."
        >{{if .ActiveFile}}{{.ActiveFile.Content}}{{else}}# VoidLAB - Local-First Cloud IDE
# Sub-millisecond execution engine (Go + HTMX + WASM)

def main():
    print("Welcome to VoidLAB 2.0")

if __name__ == "__main__":
    main()
{{end}}</textarea>
      </div>
    </div>

    <!-- ── Divider 2: Right Resizable Splitter (between Editor & Output) ── -->
    <div
      class="w-1 hover:w-1.5 cursor-col-resize transition-all duration-100 z-20 flex flex-col items-center justify-center group shrink-0"
      style="background: var(--border);"
      title="Drag to resize output terminal"
    >
      <div
        class="h-6 w-[1.5px] rounded-full group-hover:scale-125 transition-transform"
        style="background: var(--muted);"
      ></div>
    </div>

    <!-- ── Right Column: Output Panel (Width: ~520px / resizable) ── -->
    {{template "terminal" .}}
  </div>
</main>

<script>
  // Topbar Run handler opening HTML/CSS in new tab or executing in Docker
  function handleVoidLabRun(e) {
    var tag = document.getElementById('active-file-tag-path');
    var path = tag ? tag.innerText.trim() : '';
    if (!path) {
      var editor = document.getElementById('code-editor');
      path = editor ? (editor.getAttribute('data-active-path') || '') : '';
    }
    var lower = (path || '').toLowerCase();
    if (lower.endsWith('.html') || lower.endsWith('.htm') || lower.endsWith('.css')) {
      window.open('/preview?path=' + encodeURIComponent(path), '_blank');
      if (window.voidlabSwitchTab) {
        window.voidlabSwitchTab('terminal');
      }
      return;
    }
    if (window.voidlabRun) {
      window.voidlabRun(path);
    }
  }

  // Dual theme switcher
  function toggleVoidLabTheme() {
    const html = document.documentElement;
    const current = html.getAttribute('data-theme') || 'light';
    const next = current === 'dark' ? 'light' : 'dark';
    html.setAttribute('data-theme', next);
    try { localStorage.setItem('voidlab-theme', next); } catch (e) {}
    updateThemeUI(next);
  }

  function updateThemeUI(theme) {
    const isDark = theme === 'dark';
    const sun = document.getElementById('theme-icon-sun');
    const moon = document.getElementById('theme-icon-moon');
    const label = document.getElementById('theme-label');
    if (sun && moon) {
      if (isDark) {
        sun.classList.remove('hidden');
        moon.classList.add('hidden');
        if (label) label.innerText = 'Light';
      } else {
        sun.classList.add('hidden');
        moon.classList.remove('hidden');
        if (label) label.innerText = 'Dark';
      }
    }
  }

  // Restore saved theme on page load
  (function() {
    try {
      const savedTheme = localStorage.getItem('voidlab-theme') || 'light';
      document.documentElement.setAttribute('data-theme', savedTheme);
      updateThemeUI(savedTheme);
    } catch (e) {}
  })();
</script>
{{end}}

{{define "content"}}
  {{template "index" .}}
{{end}}
