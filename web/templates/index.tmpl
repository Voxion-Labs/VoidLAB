{{define "index"}}
<div class="login-page selection:bg-sky-500 selection:text-white min-h-screen flex flex-col font-sans" style="background: var(--background-main); color: var(--text);">
  <!-- ── Top Announcement Banner (Matching Flutter/VoidLAB layout) ── -->
  <aside aria-label="Announcement" class="bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 text-white text-xs py-2 px-4 text-center font-medium flex items-center justify-center gap-1.5 transition-all">
    <span>VoidLAB 2.0 is here! Client-side runtime and WebAssembly compiler are now active.</span>
    <a href="/editor" class="inline-flex items-center gap-1 underline underline-offset-2 hover:opacity-90 font-semibold ml-1">
      Explore IDE
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </a>
  </aside>

  <!-- ── Main Flutter-style Navbar ── -->
  <header
    class="login-nav border-b border-[var(--border)] bg-[var(--background-main)] sticky top-0 z-50 px-6 sm:px-10 h-16 flex items-center justify-between transition-colors"
    role="banner"
  >
    <div class="flex items-center gap-8">
      <a href="/" class="flex items-center gap-2.5">
        <svg
          width="34"
          height="34"
          viewBox="0 0 128 128"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          class="brand-logo-fill flex-shrink-0"
          aria-hidden="true"
        >
          <path d="M18 10 L54 110 L64 90 L36 10 Z" fill="currentColor" />
          <path d="M110 10 L74 110 L64 90 L92 10 Z" fill="currentColor" />
          <path d="M80 8 L44 122" stroke="currentColor" stroke-width="7" stroke-linecap="round" />
        </svg>
        <div>
          <div class="display-font font-bold theme-text-strong leading-none" style="font-size: 1.25rem; letter-spacing: -0.02em;">
            VoidLAB
          </div>
          <div class="text-xs theme-muted" style="letter-spacing: 0.04em; color: var(--muted);">
            by Voxion Labs
          </div>
        </div>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden lg:flex items-center gap-6 text-sm font-medium" style="color: var(--muted-strong);">
        <a href="#features" class="hover:text-[var(--text-strong)] transition-colors">Development</a>
        <a href="#capabilities" class="hover:text-[var(--text-strong)] transition-colors">Ecosystem</a>
        <a href="#showcase" class="hover:text-[var(--text-strong)] transition-colors">Why VoidLAB</a>
        <a href="#showcase" class="hover:text-[var(--text-strong)] transition-colors">Showcase</a>
        <a href="/editor/manual" class="hover:text-[var(--text-strong)] transition-colors">Docs</a>
      </nav>
    </div>

    <!-- Right Action Tray -->
    <div class="flex items-center gap-3">
      <a
        href="/editor"
        class="p-2 text-[var(--muted)] hover:text-[var(--text-strong)] rounded-full hover:bg-[var(--surface-soft)] transition-colors hidden sm:inline-flex"
        title="Search workspace"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </a>

      <!-- Theme Switcher -->
      <button
        onclick="toggleVoidLabTheme()"
        aria-label="Toggle theme"
        class="theme-control inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-sm theme-text select-none cursor-pointer"
        type="button"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-sky-500">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
        <span class="hidden sm:inline theme-muted text-xs">Theme</span>
      </button>

      <a
        href="#login-section"
        class="rounded-full bg-[#0468d7] hover:bg-[#0357b8] text-white text-xs sm:text-sm font-semibold px-5 py-2 shadow-sm transition-all hover:shadow"
      >
        Get started
      </a>
    </div>
  </header>

  <!-- ── 1. Main Hero Section (Faithful to src/app/page.tsx) ── -->
  <section id="features" class="relative overflow-hidden pt-12 pb-20 sm:pt-16 sm:pb-28 px-6 sm:px-10 lg:px-14">
    <!-- Subtle Cyan/Sky Angular Graphic Wash -->
    <div
      class="absolute right-0 top-0 w-full lg:w-1/2 h-full pointer-events-none opacity-30 dark:opacity-20 z-0"
      style="background: linear-gradient(135deg, #38bdf8 0%, #0284c7 50%, #0369a1 100%); clip-path: polygon(100% 0, 15% 0, 100% 85%);"
    ></div>

    <div class="max-w-7xl mx-auto grid lg:grid-cols-12 gap-12 lg:gap-8 items-center relative z-10">
      <!-- Left Column: Headline Copy strictly matching Flutter.dev design -->
      <div class="lg:col-span-7 space-y-6">
        <div class="text-[#0284c7] font-semibold text-base sm:text-lg tracking-normal">
          Development
        </div>

        <!-- Giant Display Headline -->
        <h1 class="text-5xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-[var(--text-strong)] leading-[1.08] font-display">
          Reach users on<br />
          every screen
        </h1>

        <!-- Subtitle description -->
        <p class="text-lg sm:text-xl text-[var(--muted)] leading-relaxed max-w-xl font-normal">
          Deploy to multiple devices from a single codebase: mobile, web, desktop, and embedded devices.
        </p>

        <!-- Action Buttons (Flutter Pill Style) -->
        <div class="flex flex-wrap items-center gap-4 pt-2">
          <a
            href="#showcase"
            class="rounded-full border-2 border-[#0284c7] text-[#0284c7] hover:bg-[#0284c7]/5 px-7 py-3 text-sm font-semibold transition-all inline-flex items-center gap-2"
          >
            See the target platforms
          </a>
          <a
            href="#login-section"
            class="rounded-full bg-[#0468d7] hover:bg-[#0357b8] text-white px-7 py-3 text-sm font-semibold shadow-md transition-all inline-flex items-center gap-2"
          >
            Sign in to IDE
          </a>
        </div>

        <!-- Platform Badges Row -->
        <div class="pt-6 flex flex-wrap items-center gap-3 text-xs text-[var(--muted)]">
          <span class="font-semibold text-[var(--text-strong)]">Supported Runtimes:</span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--surface-soft)] border border-[var(--border)]">
            <svg class="text-blue-500" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
            Web (HTML/JS/TS)
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--surface-soft)] border border-[var(--border)]">
            <svg class="text-emerald-500" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="4 17 10 11 4 5"></polyline>
              <line x1="12" y1="19" x2="20" y2="19"></line>
            </svg>
            Python / C++ / Java
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--surface-soft)] border border-[var(--border)]">
            <svg class="text-purple-500" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="4" y="4" width="16" height="16" rx="2"></rect>
              <rect x="9" y="9" width="6" height="6"></rect>
              <line x1="9" y1="1" x2="9" y2="4"></line>
              <line x1="15" y1="1" x2="15" y2="4"></line>
              <line x1="9" y1="20" x2="9" y2="23"></line>
              <line x1="15" y1="20" x2="15" y2="23"></line>
              <line x1="20" y1="9" x2="23" y2="9"></line>
              <line x1="20" y1="14" x2="23" y2="14"></line>
              <line x1="1" y1="9" x2="4" y2="9"></line>
              <line x1="1" y1="14" x2="4" y2="14"></line>
            </svg>
            WebAssembly (WASM)
          </span>
        </div>
      </div>

      <!-- Right Column: Sleek Login & Create Account Card (1:1 with LoginForm.tsx) -->
      <div id="login-section" class="lg:col-span-5 w-full">
        <div class="relative">
          <!-- Soft decorative background glow -->
          <div class="absolute -inset-1 rounded-3xl bg-gradient-to-r from-sky-400/20 to-blue-600/20 blur-xl opacity-70 pointer-events-none"></div>

          <div class="relative login-card shadow-2xl">
            <div class="flex items-center justify-between mb-2">
              <p class="login-card-label m-0">Local workspace</p>
              <span class="text-[11px] font-semibold text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded-full">
                Private Session
              </span>
            </div>

            <!-- Tab Switcher: Sign In vs Create Account -->
            <div class="flex items-center gap-2 mb-4 p-1 rounded-lg bg-[var(--surface-strong)] border border-[var(--border)] text-xs font-semibold">
              <button
                type="button"
                id="tab-btn-signin"
                onclick="voidlabSwitchAuthTab('signin')"
                class="flex-1 py-1.5 px-3 rounded-md transition-all text-center cursor-pointer shadow-sm"
                style="background: var(--background-main); color: var(--text-strong);"
              >
                Sign In
              </button>
              <button
                type="button"
                id="tab-btn-register"
                onclick="voidlabSwitchAuthTab('register')"
                class="flex-1 py-1.5 px-3 rounded-md transition-all text-center cursor-pointer text-[var(--muted)] hover:text-[var(--text-strong)]"
              >
                Create Account
              </button>
            </div>

            <h2 id="auth-form-title" class="login-card-title">Sign in to VoidLAB</h2>
            <p id="auth-form-subtitle" class="login-card-subtitle">
              Enter your local developer profile credentials to access your workspace.
            </p>

            <form hx-post="/api/auth/login" hx-target="#login-error" hx-swap="innerHTML" class="space-y-0" onsubmit="var u = document.getElementById('lf-input-username').value.trim(); if(u && window.voidlabSaveProfile) { window.voidlabSaveProfile(u); }">
              <input type="hidden" name="auth_mode" id="auth-mode-input" value="signin">

              <!-- Full Name (Shown in Create Account) -->
              <div id="field-fullname" class="lf-wrap relative hidden">
                <span class="lf-icon">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                </span>
                <input
                  type="text"
                  name="name"
                  id="lf-input-name"
                  placeholder=" "
                  value="{{if .User}}{{.User}}{{else}}Rudra Jena{{end}}"
                  class="lf-input"
                />
                <label class="lf-label">Full name</label>
              </div>

              <!-- Username -->
              <div class="lf-wrap relative">
                <span class="lf-icon">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"></circle><path d="M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-3.92 7.94"></path></svg>
                </span>
                <input
                  type="text"
                  name="username"
                  id="lf-input-username"
                  placeholder=" "
                  required
                  value="{{if .User}}{{.User}}{{else}}Rudra{{end}}"
                  class="lf-input"
                />
                <label class="lf-label">Username</label>
              </div>

              <!-- Email (Shown in Create Account or optional in Sign In) -->
              <div id="field-email" class="lf-wrap relative hidden">
                <span class="lf-icon">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                </span>
                <input
                  type="email"
                  name="email"
                  id="lf-input-email"
                  placeholder=" "
                  value="engineer@voxion.dev"
                  class="lf-input"
                />
                <label class="lf-label">Email address</label>
              </div>

              <!-- Password with Eye Toggle -->
              <div class="lf-wrap relative">
                <span class="lf-icon">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                </span>
                <input
                  type="password"
                  name="password"
                  id="lf-input-password"
                  placeholder=" "
                  required
                  value="voidlab-secure-pass"
                  class="lf-input pr-10"
                />
                <label class="lf-label">Password</label>
                <button
                  type="button"
                  onclick="voidlabTogglePasswordVisibility()"
                  class="absolute right-3 top-1/2 -translate-y-1/2 text-sm z-10 p-1 text-[var(--muted)] hover:text-[var(--text-strong)] cursor-pointer"
                  title="Toggle password visibility"
                >
                  <svg id="eye-icon-show" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                    <circle cx="12" cy="12" r="3"></circle>
                  </svg>
                  <svg id="eye-icon-hide" class="hidden" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                    <line x1="1" y1="1" x2="23" y2="23"></line>
                  </svg>
                </button>
              </div>

              <!-- Region / Location (Shown in Create Account) -->
              <div id="field-region" class="lf-wrap relative hidden">
                <span class="lf-icon">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="7" r="3"></circle></svg>
                </span>
                <input
                  type="text"
                  name="region"
                  id="lf-input-region"
                  placeholder=" "
                  value="Global / Asia-South"
                  class="lf-input"
                />
                <label class="lf-label">Region / Location</label>
              </div>

              <!-- Action Bar (Note + Submit) -->
              <div class="login-action-bar">
                <p class="login-action-note">
                  Saved securely in your browser session.
                </p>
                <button
                  type="submit"
                  id="auth-submit-btn"
                  class="login-submit-btn"
                >
                  <span id="auth-submit-text">Launch IDE</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </button>
              </div>

              <!-- Response or Error Container -->
              <div id="login-error"></div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 2. Multi-Screen Target Platforms Showcase (Exact 1:1 from src/app/page.tsx) ── -->
  <section id="showcase" class="border-t border-[var(--border)] bg-[var(--surface-soft)] py-20 px-6 sm:px-10">
    <div class="max-w-6xl mx-auto">
      <!-- Section Header -->
      <div class="text-center max-w-2xl mx-auto mb-16">
        <div class="text-sm font-bold uppercase tracking-widest text-[#0284c7] mb-2">
          Cross-Platform Ecosystem
        </div>
        <h2 class="display-font text-3xl sm:text-4xl font-extrabold text-[var(--text-strong)] tracking-tight">
          One unified workspace for every screen
        </h2>
        <p class="text-[var(--muted)] text-base mt-3 leading-relaxed">
          From desktop browser compilation to mobile live-previews and collaborative terminals.
        </p>
      </div>

      <!-- Device Mockup Presentation (4 New Tool Showcases) -->
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
        <!-- 1. AI Guide -->
        <div class="border border-[var(--border)] bg-[var(--background-main)] rounded-2xl p-4 shadow-sm space-y-3 hover:shadow-md transition-shadow">
          <div class="flex items-center justify-between">
            <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#0284c7]">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"></path></svg>
              AI Guide
            </span>
            <span class="text-[10px] font-medium text-blue-600 dark:text-blue-400 bg-blue-500/10 px-2 py-0.5 rounded-full font-mono">
              Real-time
            </span>
          </div>
          <div class="rounded-xl overflow-hidden border border-[var(--border)] aspect-[16/10] bg-slate-950 flex items-center justify-center">
            <img 
              src="/showcase/ai-guide.png" 
              alt="AI Guide" 
              class="w-full h-full object-cover object-top"
              loading="lazy"
            />
          </div>
          <h3 class="font-bold text-sm text-[var(--text-strong)]">Local AI Guide</h3>
          <p class="text-xs text-[var(--muted)] leading-relaxed">
            Built-in prompt assistance, interactive debugging, and code walkthroughs without server storage.
          </p>
        </div>

        <!-- 2. Collaboration Rooms -->
        <div class="border border-[var(--border)] bg-[var(--background-main)] rounded-2xl p-4 shadow-sm space-y-3 hover:shadow-md transition-shadow">
          <div class="flex items-center justify-between">
            <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-purple-600 dark:text-purple-400">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
              Collab Rooms
            </span>
            <span class="text-[10px] font-medium text-purple-600 dark:text-purple-400 bg-purple-500/10 px-2 py-0.5 rounded-full font-mono">
              WebSockets
            </span>
          </div>
          <div class="rounded-xl overflow-hidden border border-[var(--border)] aspect-[16/10] bg-slate-950 flex items-center justify-center">
            <img 
              src="/showcase/collaboration-rooms.png" 
              alt="Collaboration Rooms" 
              class="w-full h-full object-cover object-top"
              loading="lazy"
            />
          </div>
          <h3 class="font-bold text-sm text-[var(--text-strong)]">Multiplayer Rooms</h3>
          <p class="text-xs text-[var(--muted)] leading-relaxed">
            Ephemeral peer rooms, live team chat, and workspace snapshot sync with zero cloud database.
          </p>
        </div>

        <!-- 3. Developer Profile -->
        <div class="border border-[var(--border)] bg-[var(--background-main)] rounded-2xl p-4 shadow-sm space-y-3 hover:shadow-md transition-shadow">
          <div class="flex items-center justify-between">
            <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-600 dark:text-emerald-400">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
              Profile & Identity
            </span>
            <span class="text-[10px] font-medium text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded-full font-mono">
              Stateless
            </span>
          </div>
          <div class="rounded-xl overflow-hidden border border-[var(--border)] aspect-[16/10] bg-slate-950 flex items-center justify-center">
            <img 
              src="/showcase/developer-profile.png" 
              alt="Developer Profile & Identity" 
              class="w-full h-full object-cover object-top"
              loading="lazy"
            />
          </div>
          <h3 class="font-bold text-sm text-[var(--text-strong)]">Profile & Session Audit</h3>
          <p class="text-xs text-[var(--muted)] leading-relaxed">
            Local credentials, workspace inventory metrics, and browser storage activity logging.
          </p>
        </div>

        <!-- 4. Operator Manual -->
        <div class="border border-[var(--border)] bg-[var(--background-main)] rounded-2xl p-4 shadow-sm space-y-3 hover:shadow-md transition-shadow">
          <div class="flex items-center justify-between">
            <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-amber-600 dark:text-amber-400">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
              Operator Manual
            </span>
            <span class="text-[10px] font-medium text-amber-600 dark:text-amber-400 bg-amber-500/10 px-2 py-0.5 rounded-full font-mono">
              Handbook
            </span>
          </div>
          <div class="rounded-xl overflow-hidden border border-[var(--border)] aspect-[16/10] bg-slate-950 flex items-center justify-center">
            <img 
              src="/showcase/operator-manual.png" 
              alt="Operator Manual" 
              class="w-full h-full object-cover object-top"
              loading="lazy"
            />
          </div>
          <h3 class="font-bold text-sm text-[var(--text-strong)]">Illustrated Handbook</h3>
          <p class="text-xs text-[var(--muted)] leading-relaxed">
            Architectural blueprints, execution pipelines, unified console guides, and CLI references.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 3. Feature Highlights (Exact 1:1 from src/app/page.tsx) ── -->
  <section id="capabilities" class="py-20 px-6 sm:px-10 border-t border-[var(--border)] bg-[var(--background-main)]">
    <div class="max-w-6xl mx-auto">
      <div class="grid md:grid-cols-3 gap-8">
        <div class="space-y-3">
          <div class="h-10 w-10 rounded-full bg-blue-500/10 flex items-center justify-center text-[#0284c7]">
