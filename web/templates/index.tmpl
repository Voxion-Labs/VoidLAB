{{define "index"}}
<main
  class="min-h-screen w-full flex flex-col font-sans select-none antialiased transition-colors"
  style="background: var(--background-main); color: var(--text);"
>
  <!-- ========================================================================= -->
  <!-- 1. TOP NAVBAR (1:1 Replica from Next.js src/app/editor/page.tsx)          -->
  <!-- ========================================================================= -->
  <header
    class="h-12 shrink-0 px-4 flex items-center justify-between z-30 relative select-none transition-colors border-b"
    style="background: var(--panel-background); border-color: var(--border);"
  >
    <!-- Left: Brand Logo & File Path & Run Trigger -->
    <div class="flex items-center gap-3">
      <!-- Brand Logo (1:1 with Brand.tsx) -->
      <a
        href="/"
        class="flex items-center gap-2.5 group transition-opacity opacity-90 hover:opacity-100"
        title="VoidLAB Home"
      >
        <svg
          width="28"
          height="28"
          viewBox="0 0 128 128"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          class="flex-shrink-0"
          style="color: var(--text-strong);"
          aria-hidden="true"
        >
          <path d="M18 10 L54 110 L64 90 L36 10 Z" fill="currentColor" />
          <path d="M110 10 L74 110 L64 90 L92 10 Z" fill="currentColor" />
          <path d="M80 8 L44 122" stroke="currentColor" stroke-width="7" stroke-linecap="round" />
        </svg>
        <div class="font-display font-bold leading-none" style="font-size: 1.1rem; letter-spacing: -0.02em; color: var(--text-strong);">
          VoidLAB
        </div>
      </a>

      <div class="h-4 w-px" style="background: var(--border);"></div>

      <!-- Active File Path Tag -->
      <div
        id="active-file-tag"
        class="flex items-center gap-2 px-2.5 py-1 rounded-md text-xs font-sans transition-colors"
        style="background: var(--surface-soft); border: 1px solid var(--border); color: var(--muted);"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0"></span>
        <span id="active-file-tag-path" class="font-medium font-sans" style="color: var(--text-strong);">
          {{if .ActiveFile}}{{.ActiveFile.Path}}{{else}}src/main.py{{end}}
        </span>
        <span style="color: var(--border);">/</span>
        <span id="active-file-tag-lang" class="font-mono text-[11px]" style="color: var(--muted);">
          {{if .ActiveFile}}{{.ActiveFile.LanguageLabel}}{{else}}Python{{end}}
        </span>
      </div>

      <!-- Action Run Pill Button -->
      <button
        id="topbar-run-btn"
        onclick="handleVoidLabRun(event)"
        class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-semibold rounded-md shadow-sm active:scale-[0.98] transition-all disabled:opacity-40 ml-1 cursor-pointer font-sans"
        style="background: var(--action-background); color: var(--action-foreground);"
        title="Execute script (Ctrl+Enter)"
        type="button"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
          <polygon points="5 3 19 12 5 21 5 3"></polygon>
        </svg>
        <span>Run</span>
      </button>

      <!-- Save Trigger -->
      <button
        onclick="voidlabTriggerManualSave()"
        class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-medium rounded-md transition-colors cursor-pointer font-sans"
        style="background: var(--surface-soft); border: 1px solid var(--border); color: var(--text);"
        title="Save file (Ctrl+S)"
        type="button"
      >
        <svg class="w-3.5 h-3.5 stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
          <polyline points="17 21 17 13 7 13 7 21"></polyline>
          <polyline points="7 3 7 8 15 8"></polyline>
        </svg>
        <span class="hidden sm:inline">Save</span>
      </button>

      <!-- Status Message -->
      <span
        id="status-message"
        class="text-[11px] font-sans pl-1 truncate max-w-[140px]"
        style="color: var(--muted);"
      >
        {{if .StatusMessage}}{{.StatusMessage}}{{else}}Ready{{end}}
      </span>
    </div>

    <!-- Right: Navigation Links & Theme Switcher -->
    <div class="flex items-center gap-2.5">
      <nav class="flex items-center gap-1 text-xs font-medium font-sans">
        <a
          href="/editor/manual"
          class="px-2.5 py-1 rounded-md transition-colors hover:text-[var(--text-strong)] hover:bg-[var(--surface-soft)]"
          style="color: var(--muted);"
        >
          Manual
        </a>
        <a
          href="https://github.com/Voxion-Labs/VoidLAB"
          target="_blank"
          rel="noreferrer"
          class="px-2.5 py-1 rounded-md transition-colors hover:text-[var(--text-strong)] hover:bg-[var(--surface-soft)] flex items-center gap-1"
          style="color: var(--muted);"
        >
          GitHub
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-70">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
        </a>
        <a
          href="/editor/collaboration"
          class="px-2.5 py-1 rounded-md transition-colors hover:text-[var(--text-strong)] hover:bg-[var(--surface-soft)] flex items-center gap-1.5"
          style="color: var(--muted);"
        >
          <span class="w-1.5 h-1.5 rounded-full" style="background: var(--accent);"></span>
          Collab
        </a>
        <a
          href="/editor/ai"
          class="px-2.5 py-1 rounded-md transition-colors hover:text-[var(--text-strong)] hover:bg-[var(--surface-soft)]"
          style="color: var(--muted);"
        >
          AI Guide
        </a>
      </nav>

      <div class="h-4 w-px" style="background: var(--border);"></div>

      <!-- Dual Theme Switcher (Light / Dark) -->
      <button
        id="theme-switcher-btn"
        onclick="toggleVoidLabTheme()"
        class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs select-none cursor-pointer transition-colors"
        style="background: var(--control-background); border: 1px solid var(--border); color: var(--text);"
        aria-label="Toggle theme"
        type="button"
      >
        <svg id="theme-icon-sun" class="w-3.5 h-3.5 hidden" style="color: var(--accent);" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <svg id="theme-icon-moon" class="w-3.5 h-3.5" style="color: var(--accent);" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
        <span id="theme-label" class="hidden sm:inline text-xs" style="color: var(--muted);">Dark</span>
      </button>

      <!-- Settings Trigger -->
      <button
        hx-get="/api/ui/modal/settings"
        hx-target="#modal-container"
        hx-swap="innerHTML"
        class="p-1.5 rounded-md transition-colors hover:bg-[var(--surface-soft)] cursor-pointer"
        style="color: var(--muted);"
        title="Workspace Settings"
        type="button"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="3"></circle>
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
        </svg>
      </button>

      <!-- User Profile Avatar -->
      <a
        href="/editor/profile"
        class="h-6 w-6 rounded-md flex items-center justify-center text-[10px] font-semibold transition-all hover:scale-105"
        style="background: var(--surface-soft); border: 1px solid var(--border); color: var(--text-strong);"
        title="Profile & Activity"
      >
        {{if .UserInitial}}{{.UserInitial}}{{else}}R{{end}}
      </a>
    </div>
  </header>

  <!-- ========================================================================= -->
  <!-- 2. MAIN WORKSPACE (3-Column Layout: Explorer, Editor, Terminal)            -->
  <!-- ========================================================================= -->
  <div
    id="editor-workspace"
    class="flex-1 flex flex-col lg:flex-row overflow-y-auto lg:overflow-hidden min-h-[640px] relative transition-colors"
    style="background: var(--background-main);"
  >
    <!-- Left Column: File Explorer (explorer.tmpl) -->
    {{template "explorer" .}}

    <!-- Divider 1: Left Splitter (between Explorer & Editor) -->
    <div
      class="w-1 hover:w-1.5 cursor-col-resize transition-all duration-100 z-20 flex flex-col items-center justify-center group shrink-0"
      style="background: var(--border);"
      title="Drag to resize explorer"
    >
      <div
        class="h-6 w-[1.5px] rounded-full group-hover:scale-125 transition-transform"
        style="background: var(--muted);"
      ></div>
    </div>

    <!-- Middle Column: Main Code Editor (editor.tmpl) -->
    {{template "editor" .}}

    <!-- Divider 2: Right Splitter (between Editor & Terminal) -->
    <div
      class="w-1 hover:w-1.5 cursor-col-resize transition-all duration-100 z-20 flex flex-col items-center justify-center group shrink-0"
      style="background: var(--border);"
      title="Drag to resize terminal"
    >
      <div
        class="h-6 w-[1.5px] rounded-full group-hover:scale-125 transition-transform"
        style="background: var(--muted);"
      ></div>
    </div>

    <!-- Right Column: Interactive xterm.js Terminal & Output (terminal.tmpl) -->
    {{template "terminal" .}}
  </div>
</main>

<!-- Client-Side Vanilla JS Logic: WASM Loading, Gutter Sync, Shortcuts, Theme -->
<script>
  // 1. Run Trigger
  function handleVoidLabRun(e) {
    if (e) e.preventDefault();
    var tag = document.getElementById('active-file-tag-path');
    var path = tag ? tag.innerText.trim() : '';
    if (!path) {
      var editor = document.getElementById('code-editor');
      path = editor ? (editor.getAttribute('data-active-path') || '') : '';
    }
    var lower = (path || '').toLowerCase();
    if (lower.endsWith('.html') || lower.endsWith('.htm') || lower.endsWith('.css')) {
      window.open('/preview?path=' + encodeURIComponent(path), '_blank');
      if (window.voidlabSwitchTab) {
        window.voidlabSwitchTab('terminal');
      }
      return;
    }
    if (window.voidlabRun) {
      window.voidlabRun(path);
    }
  }

  // 2. Manual Save Trigger
  function voidlabTriggerManualSave() {
    var editor = document.getElementById('code-editor');
    if (!editor) return;
    var content = editor.value;
    var status = document.getElementById('status-message');
    if (status) status.innerText = 'Saving...';
    htmx.ajax('POST', '/api/files/save', {
      values: { content: content },
      target: '#status-message',
      swap: 'innerHTML'
    });
  }

  // 3. Line Number Gutter Synchronization
  function voidlabUpdateGutter(editor) {
    if (!editor) editor = document.getElementById('code-editor');
    if (!editor) return;
    var gutter = document.getElementById('editor-gutter');
    if (!gutter) return;

    var lines = (editor.value || '').split('\n').length;
    var currentLines = gutter.children.length;

    if (currentLines !== lines) {
      var fragment = document.createDocumentFragment();
      for (var i = 1; i <= lines; i++) {
        var div = document.createElement('div');
        div.textContent = i;
        fragment.appendChild(div);
      }
      gutter.innerHTML = '';
      gutter.appendChild(fragment);
    }

    var metricLines = document.getElementById('wasm-metrics-lines');
    if (metricLines) metricLines.textContent = lines + 'L';
  }

  function voidlabSyncGutterScroll(editor) {
    var gutter = document.getElementById('editor-gutter');
    if (gutter && editor) {
      gutter.scrollTop = editor.scrollTop;
    }
  }

  function voidlabHandleEditorInput(editor) {
    voidlabUpdateGutter(editor);
    var lang = editor.getAttribute('data-active-lang') || 'python';
    voidlabValidateCode(editor.value, lang);
  }

  function voidlabHandleEditorKeydown(e, editor) {
    // Tab key: insert 2 spaces
    if (e.key === 'Tab') {
      e.preventDefault();
      var start = editor.selectionStart;
      var end = editor.selectionEnd;
      editor.value = editor.value.substring(0, start) + '  ' + editor.value.substring(end);
      editor.selectionStart = editor.selectionEnd = start + 2;
      voidlabHandleEditorInput(editor);
      return;
    }
    // Ctrl+S: Save file
    if ((e.ctrlKey || e.metaKey) && e.key === 's') {
      e.preventDefault();
      voidlabTriggerManualSave();
      return;
    }
    // Ctrl+Enter: Run code
    if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
      e.preventDefault();
      handleVoidLabRun(e);
      return;
    }
  }

  // 4. WebAssembly Instant Client-Side Syntax Validation & Format
  function voidlabValidateCode(code, lang) {
    if (!window.voidlabWASM || !window.voidlabWASM.validate) return;
    try {
      var res = window.voidlabWASM.validate(code, lang);
      if (typeof res === 'string') res = JSON.parse(res);
      var banner = document.getElementById('wasm-syntax-banner');
      var ind = document.getElementById('wasm-syntax-indicator');
      var errText = document.getElementById('wasm-syntax-error-text');
      var errPos = document.getElementById('wasm-syntax-pos');

      if (res && !res.valid) {
        if (banner) banner.classList.remove('hidden');
        if (ind) {
          ind.textContent = 'Alert';
          ind.className = 'font-mono text-[11px] text-rose-500 font-bold';
        }
        if (errText) errText.textContent = res.message || 'Syntax error';
        if (errPos && res.line) errPos.textContent = 'Line ' + res.line + (res.column ? (':' + res.column) : '');
      } else {
        if (banner) banner.classList.add('hidden');
        if (ind) {
          ind.textContent = 'Valid';
          ind.className = 'font-mono text-[11px] text-emerald-500';
        }
      }
    } catch (_) {}
  }

  function voidlabFormatCode() {
    var editor = document.getElementById('code-editor');
    if (!editor) return;
    var lang = editor.getAttribute('data-active-lang') || 'python';
    if (window.voidlabWASM && window.voidlabWASM.format) {
      try {
        var formatted = window.voidlabWASM.format(editor.value, lang);
        if (formatted) {
          editor.value = formatted;
          voidlabHandleEditorInput(editor);
          voidlabTriggerManualSave();
        }
      } catch (_) {}
    }
  }

  // 5. Asynchronous WebAssembly Engine Loading (Non-Blocking)
  (function() {
    function loadWASM() {
      if (window._voidlabWASMLoaded) return;
      window._voidlabWASMLoaded = true;

      const wasmScript = document.createElement('script');
      wasmScript.src = '/public/wasm/wasm_exec.js';
      wasmScript.async = true;
      wasmScript.onload = function() {
        if (typeof Go === 'undefined') return;
        const go = new Go();
        const instantiate = WebAssembly.instantiateStreaming
          ? WebAssembly.instantiateStreaming(fetch('/public/wasm/voidlab.wasm'), go.importObject)
          : fetch('/public/wasm/voidlab.wasm').then(res => res.arrayBuffer()).then(bytes => WebAssembly.instantiate(bytes, go.importObject));

        instantiate.then(result => {
          go.run(result.instance);
          const badgeDot = document.getElementById('wasm-dot');
          const badgeText = document.getElementById('wasm-status-text');
          if (badgeDot) badgeDot.className = 'w-1.5 h-1.5 rounded-full bg-emerald-400';
          if (badgeText) badgeText.textContent = 'WASM Ready';

          var editor = document.getElementById('code-editor');
          if (editor) {
            voidlabUpdateGutter(editor);
            voidlabValidateCode(editor.value, editor.getAttribute('data-active-lang') || 'python');
          }
        }).catch(err => {
          console.warn('[VoidLAB WASM] initialization deferred:', err);
        });
      };
      document.body.appendChild(wasmScript);
    }

    if (document.readyState === 'complete') {
      loadWASM();
    } else {
      window.addEventListener('load', loadWASM);
    }
  })();

  // 6. Theme Switcher (Dark / Light)
  function toggleVoidLabTheme() {
    const html = document.documentElement;
    const current = html.getAttribute('data-theme') || 'light';
    const next = current === 'dark' ? 'light' : 'dark';
    html.setAttribute('data-theme', next);
    try { localStorage.setItem('voidlab-theme', next); } catch (e) {}
    updateThemeUI(next);
  }

  function updateThemeUI(theme) {
    const isDark = theme === 'dark';
    const sun = document.getElementById('theme-icon-sun');
    const moon = document.getElementById('theme-icon-moon');
    const label = document.getElementById('theme-label');
    if (sun && moon) {
      if (isDark) {
        sun.classList.remove('hidden');
        moon.classList.add('hidden');
        if (label) label.innerText = 'Light';
      } else {
        sun.classList.add('hidden');
        moon.classList.remove('hidden');
        if (label) label.innerText = 'Dark';
      }
    }
  }

  // Restore theme on mount
  (function() {
    try {
      const savedTheme = localStorage.getItem('voidlab-theme') || 'light';
      document.documentElement.setAttribute('data-theme', savedTheme);
      updateThemeUI(savedTheme);
    } catch (e) {}
  })();
</script>
{{end}}

{{define "content"}}
  {{template "index" .}}
{{end}}
