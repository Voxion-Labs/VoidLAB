<!-- Dynamic Client-Side Logic for Sign In / Create Account Tabs and Password Toggle -->
<script>
  function voidlabSwitchAuthTab(tab) {
    var isRegister = tab === 'register';
    var signinBtn = document.getElementById('tab-btn-signin');
    var regBtn = document.getElementById('tab-btn-register');
    var modeInput = document.getElementById('auth-mode-input');
    var title = document.getElementById('auth-form-title');
    var subtitle = document.getElementById('auth-form-subtitle');
    var submitText = document.getElementById('auth-submit-text');

    var fieldName = document.getElementById('field-fullname');
    var fieldEmail = document.getElementById('field-email');
    var fieldRegion = document.getElementById('field-region');

    if (isRegister) {
      signinBtn.style.background = 'transparent';
      signinBtn.style.color = 'var(--muted)';
      signinBtn.classList.remove('shadow-sm');

      regBtn.style.background = 'var(--background-main)';
      regBtn.style.color = 'var(--text-strong)';
      regBtn.classList.add('shadow-sm');

      if (modeInput) modeInput.value = 'register';
      if (title) title.innerText = 'Create VoidLAB Account';
      if (subtitle) subtitle.innerText = 'Set up your developer profile to initialize local storage & workspace.';
      if (submitText) submitText.innerText = 'Create & Launch';

      if (fieldName) fieldName.classList.remove('hidden');
      if (fieldEmail) fieldEmail.classList.remove('hidden');
      if (fieldRegion) fieldRegion.classList.remove('hidden');
    } else {
      regBtn.style.background = 'transparent';
      regBtn.style.color = 'var(--muted)';
      regBtn.classList.remove('shadow-sm');

      signinBtn.style.background = 'var(--background-main)';
      signinBtn.style.color = 'var(--text-strong)';
      signinBtn.classList.add('shadow-sm');

      if (modeInput) modeInput.value = 'signin';
      if (title) title.innerText = 'Sign in to VoidLAB';
      if (subtitle) subtitle.innerText = 'Enter your local developer profile credentials to access your workspace.';
      if (submitText) submitText.innerText = 'Launch IDE';

      if (fieldName) fieldName.classList.add('hidden');
      if (fieldEmail) fieldEmail.classList.add('hidden');
      if (fieldRegion) fieldRegion.classList.add('hidden');
    }
  }

  function voidlabTogglePasswordVisibility() {
    var passInput = document.getElementById('lf-input-password');
    var showIcon = document.getElementById('eye-icon-show');
    var hideIcon = document.getElementById('eye-icon-hide');
    if (!passInput) return;

    if (passInput.type === 'password') {
      passInput.type = 'text';
      if (showIcon) showIcon.classList.add('hidden');
      if (hideIcon) hideIcon.classList.remove('hidden');
    } else {
      passInput.type = 'password';
      if (showIcon) showIcon.classList.remove('hidden');
      if (hideIcon) hideIcon.classList.add('hidden');
    }
  }
  // Restore username from localStorage if available
  document.addEventListener('DOMContentLoaded', function() {
    if (window.voidlabGetProfile) {
      var p = window.voidlabGetProfile();
      if (p && p.username) {
        var input = document.getElementById('lf-input-username');
        if (input) input.value = p.username;
      }
    }
  });
</script>
