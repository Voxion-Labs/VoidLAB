{{define "index"}}
<div class="login-page selection:bg-sky-500 selection:text-white min-h-screen flex flex-col font-sans" style="background: var(--background-main); color: var(--text);">
  <!-- ── Top Announcement Banner ── -->
  <aside aria-label="Announcement" class="bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 text-white text-xs py-2 px-4 text-center font-medium flex items-center justify-center gap-1.5 transition-all">
    <span>VoidLAB 2.0 is here! Client-side runtime and WebAssembly compiler are now active.</span>
    <a href="/editor" class="inline-flex items-center gap-1 underline underline-offset-2 hover:opacity-90 font-semibold ml-1">
      Explore IDE
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </a>
  </aside>

  <!-- ── Main Flutter-style Navbar ── -->
  <header
    class="login-nav border-b border-[var(--border)] bg-[var(--background-main)] sticky top-0 z-50 px-6 sm:px-10 h-16 flex items-center justify-between transition-colors"
    role="banner"
  >
    <div class="flex items-center gap-8">
      <a href="/" class="flex items-center gap-2.5">
        <svg
          width="34"
          height="34"
          viewBox="0 0 128 128"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          class="brand-logo-fill flex-shrink-0"
          aria-hidden="true"
        >
          <path d="M18 10 L54 110 L64 90 L36 10 Z" fill="currentColor" />
          <path d="M110 10 L74 110 L64 90 L92 10 Z" fill="currentColor" />
          <path d="M80 8 L44 122" stroke="currentColor" stroke-width="7" stroke-linecap="round" />
        </svg>
        <div>
          <div class="display-font font-bold theme-text-strong leading-none" style="font-size: 1.25rem; letter-spacing: -0.02em;">
            VoidLAB
          </div>
          <div class="text-xs theme-muted" style="letter-spacing: 0.04em; color: var(--muted);">
            by Voxion Labs
          </div>
        </div>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden lg:flex items-center gap-6 text-sm font-medium" style="color: var(--muted-strong);">
        <a href="#features" class="hover:text-[var(--text-strong)] transition-colors">Development</a>
        <a href="#capabilities" class="hover:text-[var(--text-strong)] transition-colors">Ecosystem</a>
        <a href="#showcase" class="hover:text-[var(--text-strong)] transition-colors">Why VoidLAB</a>
        <a href="#showcase" class="hover:text-[var(--text-strong)] transition-colors">Showcase</a>
        <a href="/editor/manual" class="hover:text-[var(--text-strong)] transition-colors">Docs</a>
      </nav>
    </div>

    <!-- Right Action Tray -->
    <div class="flex items-center gap-3">
      <a
        href="/editor"
        class="p-2 text-[var(--muted)] hover:text-[var(--text-strong)] rounded-full hover:bg-[var(--surface-soft)] transition-colors hidden sm:inline-flex"
        title="Search workspace"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </a>

      <!-- Theme Switcher -->
      <button
        hx-post="/api/ui/theme"
        hx-target="html"
        hx-swap="outerHTML"
        aria-label="Toggle theme"
        class="theme-control inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-sm theme-text select-none cursor-pointer"
        type="button"
      >
        {{if eq .Theme "dark"}}
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-amber-400">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
          <span class="hidden sm:inline theme-muted text-xs">Light</span>
        {{else}}
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-sky-500">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
          <span class="hidden sm:inline theme-muted text-xs">Dark</span>
        {{end}}
      </button>

      <a
        href="#login-section"
        class="rounded-full bg-[#0468d7] hover:bg-[#0357b8] text-white text-xs sm:text-sm font-semibold px-5 py-2 shadow-sm transition-all hover:shadow"
      >
        Get started
      </a>
    </div>
  </header>

  <!-- ── Main Hero Section ── -->
  <section class="relative overflow-hidden pt-12 pb-20 sm:pt-16 sm:pb-28 px-6 sm:px-10 lg:px-14 flex-1 flex items-center">
    <div
      class="absolute right-0 top-0 w-full lg:w-1/2 h-full pointer-events-none opacity-30 dark:opacity-20 z-0"
      style="background: linear-gradient(135deg, #38bdf8 0%, #0284c7 50%, #0369a1 100%); clip-path: polygon(100% 0, 15% 0, 100% 85%);"
    ></div>

    <div class="max-w-7xl mx-auto grid lg:grid-cols-12 gap-12 lg:gap-8 items-center relative z-10 w-full">
      <!-- Left Column: Headline Copy -->
      <div class="lg:col-span-7 space-y-6">
        <div class="text-[#0284c7] font-semibold text-base sm:text-lg tracking-normal">
          Development
        </div>

        <h1 class="text-5xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-[var(--text-strong)] leading-[1.08] font-display">
          Reach users on<br />
          every screen
        </h1>

        <p class="text-lg sm:text-xl text-[var(--muted)] leading-relaxed max-w-xl font-normal">
          Deploy to multiple devices from a single codebase: mobile, web, desktop, and embedded devices.
        </p>

        <!-- Action Buttons -->
        <div class="flex flex-wrap items-center gap-4 pt-2">
          <a
            href="/editor"
            class="rounded-full border-2 border-[#0284c7] text-[#0284c7] hover:bg-[#0284c7]/5 px-7 py-3 text-sm font-semibold transition-all inline-flex items-center gap-2"
          >
            Launch Web IDE
          </a>
          <a
            href="#login-section"
            class="rounded-full bg-[#0468d7] hover:bg-[#0357b8] text-white px-7 py-3 text-sm font-semibold shadow-md transition-all inline-flex items-center gap-2"
          >
            Sign in to IDE
          </a>
        </div>

        <!-- Platform Badges Row -->
        <div class="pt-6 flex flex-wrap items-center gap-3 text-xs text-[var(--muted)]">
          <span class="font-semibold text-[var(--text-strong)]">Supported Runtimes:</span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--surface-soft)] border border-[var(--border)]">
            <svg class="text-blue-500" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
            Web (HTML/JS/TS)
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--surface-soft)] border border-[var(--border)]">
            <svg class="text-emerald-500" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="4 17 10 11 4 5"></polyline><line x1="12" y1="19" x2="20" y2="19"></line></svg>
            Python / C++ / Java
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--surface-soft)] border border-[var(--border)]">
            <svg class="text-purple-500" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="2"></rect><rect x="9" y="9" width="6" height="6"></rect><line x1="9" y1="1" x2="9" y2="4"></line><line x1="15" y1="1" x2="15" y2="4"></line><line x1="9" y1="20" x2="9" y2="23"></line><line x1="15" y1="20" x2="15" y2="23"></line><line x1="20" y1="9" x2="23" y2="9"></line><line x1="20" y1="14" x2="23" y2="14"></line><line x1="1" y1="9" x2="4" y2="9"></line><line x1="1" y1="14" x2="4" y2="14"></line></svg>
            WebAssembly (WASM)
          </span>
        </div>
      </div>

      <!-- Right Column: Login Card (Objective 1) -->
      <div id="login-section" class="lg:col-span-5 w-full">
        <div class="relative">
          <div class="absolute -inset-1 rounded-3xl bg-gradient-to-r from-sky-400/20 to-blue-600/20 blur-xl opacity-70 pointer-events-none"></div>
          <div class="relative rounded-2xl p-6 sm:p-8 shadow-xl border" style="background: var(--panel-background); border-color: var(--border);">
            <div class="space-y-4">
              <div>
                <h2 class="text-xl font-bold font-display" style="color: var(--text-strong);">Sign in to VoidLAB</h2>
                <p class="text-xs mt-1" style="color: var(--muted);">Choose your authentication method to access your workspace.</p>
              </div>

              <!-- HTMX Authenticated Login Form -->
              <form hx-post="/api/auth/login" class="space-y-3">
                <div>
                  <label class="block text-xs font-medium mb-1" style="color: var(--muted-strong);">Username or Email</label>
                  <input
                    type="text"
                    name="username"
                    id="login-username"
                    required
                    value="Rudra"
                    placeholder="engineer@voxion.dev"
                    class="w-full px-3 py-2 text-xs rounded-lg border outline-none transition-colors"
                    style="background: var(--input-background); border-color: var(--border); color: var(--text);"
                  />
                </div>
                <div>
                  <label class="block text-xs font-medium mb-1" style="color: var(--muted-strong);">Password</label>
                  <input
                    type="password"
                    name="password"
                    required
                    value="••••••••••••"
                    placeholder="••••••••••••"
                    class="w-full px-3 py-2 text-xs rounded-lg border outline-none transition-colors"
                    style="background: var(--input-background); border-color: var(--border); color: var(--text);"
                  />
                </div>
                <div id="login-response"></div>
                <button
                  type="submit"
                  class="w-full py-2.5 px-4 rounded-lg text-xs font-semibold text-white shadow-sm transition-all hover:shadow cursor-pointer"
                  style="background: var(--action-background);"
                >
                  Sign In to IDE
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>
{{end}}

{{define "index.tmpl"}}
{{template "base.tmpl" .}}
{{end}}
