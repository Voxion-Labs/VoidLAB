<!DOCTYPE html>
<html lang="en" data-theme="{{if .Theme}}{{.Theme}}{{else}}light{{end}}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{if .Title}}{{.Title}}{{else}}VoidLAB - Local-First Cloud IDE{{end}}</title>
  <meta name="description" content="Local-first browser IDE, compiler, and workspace by Voxion Labs.">
  <link rel="icon" type="image/svg+xml" href="/assets/icon.svg">
  <link rel="alternate icon" href="/favicon.svg">

  <!-- Google Fonts: Inter & Outfit -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Tailwind CSS Engine -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- HTMX: Zero client-side JS bloat, hyper-optimized reactive HTML swaps -->
  <script src="https://unpkg.com/htmx.org@1.9.12"></script>

  <!-- xterm.js: Minimalist, hyper-optimized terminal emulator & fit addon -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@xterm/xterm@5.5.0/css/xterm.min.css" />
  <script src="https://cdn.jsdelivr.net/npm/@xterm/xterm@5.5.0/lib/xterm.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@xterm/addon-fit@0.10.0/lib/addon-fit.min.js"></script>

  <!-- Design System Root Variables & Styles (1:1 with src/app/globals.css) -->
  <style>
    :root,
    :root[data-theme="light"] {
      --font-body: 'Inter', system-ui, -apple-system, sans-serif;
      --font-display: 'Outfit', system-ui, -apple-system, sans-serif;

      /* Text */
      --text:           #1a1a1a;
      --text-strong:    #0d0d0d;
      --muted:          #6b7280;
      --muted-strong:   #374151;

      /* Accent — Flutter blue */
      --accent:         #0468d7;
      --accent-strong:  #0357b8;
      --accent-soft:    rgba(4, 104, 215, 0.07);
      --accent-text:    #0468d7;

      /* Borders */
      --border:         rgba(0, 0, 0, 0.08);
      --border-strong:  rgba(4, 104, 215, 0.25);

      /* Surfaces */
      --background-main:    #ffffff;
      --glass-background:   #ffffff;
      --panel-background:   #ffffff;
      --shell-background:   #f8f9fa;
      --surface-soft:       #f8f9fa;
      --surface-strong:     #f1f3f5;
      --surface-elevated:   #ffffff;
      --control-background: #f8f9fa;
      --control-hover:      #f1f3f5;
      --input-background:   #ffffff;

      /* Shadows */
      --shadow:       0 1px 3px rgba(0,0,0,0.07), 0 4px 16px rgba(0,0,0,0.05);
      --shadow-hover: 0 2px 8px rgba(0,0,0,0.09), 0 8px 32px rgba(0,0,0,0.07);
      --focus-ring:   rgba(4, 104, 215, 0.22);

      /* Action button */
      --action-background: #0468d7;
      --action-foreground: #ffffff;
      --action-shadow:     0 4px 14px rgba(4, 104, 215, 0.28);

      /* Terminal */
      --terminal-bg:    #f8f9fa;
      --terminal-text:  #1a1a1a;
      --terminal-muted: #6b7280;
    }

    :root[data-theme="dark"] {
      --text:           #e5e7eb;
      --text-strong:    #f9fafb;
      --muted:          #9ca3af;
      --muted-strong:   #d1d5db;

      --accent:         #54a0ff;
      --accent-strong:  #74b9ff;
      --accent-soft:    rgba(84, 160, 255, 0.10);
      --accent-text:    #54a0ff;

      --border:         rgba(255, 255, 255, 0.08);
      --border-strong:  rgba(84, 160, 255, 0.25);

      --background-main:    #111111;
      --glass-background:   #1a1a1a;
      --panel-background:   #1a1a1a;
      --shell-background:   #111111;
      --surface-soft:       #1e1e1e;
      --surface-strong:     #252525;
      --surface-elevated:   #2a2a2a;
      --control-background: #1e1e1e;
      --control-hover:      #252525;
      --input-background:   #1a1a1a;

      --shadow:       0 1px 3px rgba(0,0,0,0.4), 0 4px 16px rgba(0,0,0,0.3);
      --shadow-hover: 0 2px 8px rgba(0,0,0,0.5), 0 8px 32px rgba(0,0,0,0.4);
      --focus-ring:   rgba(84, 160, 255, 0.25);

      --action-background: #54a0ff;
      --action-foreground: #0a0a0a;
      --action-shadow:     0 4px 14px rgba(84, 160, 255, 0.28);

      --terminal-bg:    #1a1a1a;
      --terminal-text:  #e5e7eb;
      --terminal-muted: #9ca3af;
    }

    body {
      font-family: var(--font-body);
      background: var(--background-main);
      color: var(--text);
    }

    .display-font,
    .font-display {
      font-family: var(--font-display);
      letter-spacing: -0.01em;
    }

    .theme-text        { color: var(--text); }
    .theme-text-strong { color: var(--text-strong); }
    .theme-muted       { color: var(--muted); }
    .theme-muted-strong{ color: var(--muted-strong); }
    .accent-text       { color: var(--accent); }

    .brand-logo-fill {
      color: var(--text-strong);
    }

    /* ─── Shared surfaces & controls ─── */
    .theme-surface,
    .theme-card {
      background: var(--surface-soft);
      border: 1px solid var(--border);
      border-radius: 12px;
      box-shadow: var(--shadow);
    }

    .theme-control {
      background: var(--control-background);
      border: 1px solid var(--border);
      color: var(--text);
      transition: background 0.15s, border-color 0.15s;
    }

    .theme-control:hover {
      background: var(--control-hover);
      border-color: var(--border-strong);
    }

    .theme-button-primary {
      background: var(--action-background);
      color: var(--action-foreground);
      border: none;
      border-radius: 8px;
      font-weight: 600;
      transition: opacity 0.15s, box-shadow 0.15s;
    }
    .theme-button-primary:hover {
      opacity: 0.9;
      box-shadow: var(--action-shadow);
    }

    .theme-button-secondary {
      background: transparent;
      color: var(--accent);
      border: 1.5px solid var(--border);
      border-radius: 8px;
      font-weight: 500;
      transition: border-color 0.15s, background 0.15s;
    }
    .theme-button-secondary:hover {
      border-color: var(--accent);
      background: var(--accent-soft);
    }

    /* ─── Scrollbar ─── */
    .scrollbar-thin {
      scrollbar-color: var(--border-strong) transparent;
      scrollbar-width: thin;
    }
    .scrollbar-thin::-webkit-scrollbar {
      width: 5px;
      height: 5px;
    }
    .scrollbar-thin::-webkit-scrollbar-track {
      background: transparent;
    }
    .scrollbar-thin::-webkit-scrollbar-thumb {
      background: var(--border);
      border-radius: 4px;
    }
    .scrollbar-thin::-webkit-scrollbar-thumb:hover {
      background: var(--muted);
    }

    /* ══════════════════════════════════════════════════════════════
       LOGIN PAGE & FLOATING LABELS (1:1 with src/app/globals.css)
       ══════════════════════════════════════════════════════════════ */
    .login-page {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      background: var(--background-main);
    }

    .login-nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 2rem;
      height: 64px;
      border-bottom: 1px solid var(--border);
      background: var(--background-main);
      position: sticky;
      top: 0;
      z-index: 50;
    }

    .login-card {
      background: var(--surface-soft);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 2rem;
      width: 100%;
    }

    .login-card-label {
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--accent);
      margin: 0 0 1rem;
    }

    .login-card-title {
      font-family: var(--font-display);
      font-size: 1.45rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      color: var(--text-strong);
      margin: 0 0 0.35rem;
    }

    .login-card-subtitle {
      font-size: 0.875rem;
      line-height: 1.6;
      color: var(--muted);
      margin: 0 0 1.5rem;
    }

    /* Floating-label inputs */
    .lf-wrap {
      position: relative;
      margin-bottom: 0.875rem;
    }

    .lf-input {
      width: 100%;
      background: var(--input-background);
      border: 1.5px solid var(--border);
      border-radius: 8px;
      padding: 1.15rem 0.875rem 0.45rem 2.6rem;
      font-size: 0.9rem;
      color: var(--text);
      outline: none;
      transition: border-color 0.15s, box-shadow 0.15s;
      line-height: 1;
      display: block;
    }

    .lf-input::placeholder {
      color: transparent;
    }

    .lf-input:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px var(--focus-ring);
    }

    .lf-label {
      position: absolute;
      left: 2.6rem;
      top: 50%;
      transform: translateY(-50%);
      font-size: 0.875rem;
      color: var(--muted);
      pointer-events: none;
      transition: top 0.15s ease, font-size 0.15s ease, color 0.15s ease;
      line-height: 1;
      transform-origin: left center;
      white-space: nowrap;
    }

    .lf-input:focus ~ .lf-label,
    .lf-input:not(:placeholder-shown) ~ .lf-label {
      top: 0.55rem;
      font-size: 0.68rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      color: var(--accent);
      transform: translateY(0);
    }

    .lf-icon {
      position: absolute;
      left: 0.85rem;
      top: 50%;
      transform: translateY(-50%);
      color: var(--muted);
      pointer-events: none;
      transition: color 0.15s;
      line-height: 0;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .lf-wrap:focus-within .lf-icon {
      color: var(--accent);
    }

    .login-action-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
      background: var(--background-main);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 0.875rem 1rem;
      margin-top: 0.5rem;
    }

    .login-action-note {
      font-size: 0.8rem;
      color: var(--muted);
      line-height: 1.5;
      margin: 0;
    }

    .login-submit-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      background: var(--action-background);
      color: var(--action-foreground);
      border: none;
      border-radius: 8px;
      padding: 0.65rem 1.25rem;
      font-size: 0.875rem;
      font-weight: 600;
      cursor: pointer;
      white-space: nowrap;
      transition: opacity 0.15s, box-shadow 0.15s, transform 0.12s;
      box-shadow: var(--action-shadow);
      flex-shrink: 0;
      outline: none;
    }

    .login-submit-btn:hover:not(:disabled) {
      opacity: 0.9;
      transform: translateY(-1px);
      box-shadow: 0 8px 24px rgba(4, 104, 215, 0.32);
    }
    [data-theme="dark"] .login-submit-btn:hover:not(:disabled) {
      box-shadow: 0 8px 24px rgba(84, 160, 255, 0.32);
    }

    .login-error {
      margin-top: 0.75rem;
      background: rgba(220, 38, 38, 0.06);
      border: 1px solid rgba(220, 38, 38, 0.2);
      border-radius: 8px;
      padding: 0.75rem 1rem;
      font-size: 0.85rem;
      color: #dc2626;
      line-height: 1.5;
    }
    [data-theme="dark"] .login-error {
      color: #f87171;
      background: rgba(248, 113, 113, 0.08);
      border-color: rgba(248, 113, 113, 0.2);
    }
  </style>
</head>
<body class="{{if and .IsEditor (or (eq .SubView "") (eq .SubView "editor"))}}h-screen w-screen overflow-hidden{{else}}min-h-screen w-full overflow-y-auto{{end}} flex flex-col font-sans select-none antialiased transition-colors" style="background: var(--background-main); color: var(--text);">
  {{block "content" .}}
    {{if .IsEditor}}
      {{if eq .SubView "manual"}}
        {{template "manual-page" .}}
      {{else if or (eq .SubView "collab") (eq .SubView "collaboration")}}
        {{template "collab-page" .}}
      {{else if eq .SubView "ai"}}
        {{template "ai-page" .}}
      {{else if eq .SubView "profile"}}
        {{template "profile-page" .}}
      {{else if eq .SubView "github"}}
        {{template "github-page" .}}
      {{else}}
        {{template "editor-page" .}}
      {{end}}
    {{else}}
      {{template "index" .}}
    {{end}}
  {{end}}

  <!-- Global Modal Host for HTMX Dynamic Dialogs -->
  <div id="modal-container"></div>

  <!-- Client-side LocalStorage Auth Modal (100% Stateless - Directive 1) -->
  <div id="voidlab-auth-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/70 backdrop-blur-md">
    <div class="w-full max-w-sm rounded-2xl p-6 shadow-2xl transition-colors font-sans border" style="background: var(--panel-background); border-color: var(--border-strong); color: var(--text);">
      <div class="text-center space-y-3">
        <div class="w-12 h-12 mx-auto rounded-xl flex items-center justify-center bg-[var(--accent)] text-white shadow-lg">
          <svg width="24" height="24" viewBox="0 0 128 128" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M18 10 L54 110 L64 90 L36 10 Z" fill="currentColor" />
            <path d="M110 10 L74 110 L64 90 L92 10 Z" fill="currentColor" />
            <path d="M80 8 L44 122" stroke="currentColor" stroke-width="7" stroke-linecap="round" />
          </svg>
        </div>
        <div>
          <h3 class="text-lg font-bold tracking-tight text-[var(--text-strong)] display-font">Welcome to VoidLAB</h3>
          <p class="text-xs text-[var(--muted)] mt-1">100% Stateless & Local-First Browser IDE</p>
        </div>
      </div>

      <form id="voidlab-auth-form" onsubmit="handleVoidlabAuthSubmit(event)" class="mt-5 space-y-4">
        <div>
          <label class="block text-[11px] font-semibold text-[var(--muted)] uppercase tracking-wider mb-1.5">Choose your Username</label>
          <input
            id="voidlab-username-input"
            type="text"
            placeholder="e.g. Rudra"
            autocomplete="off"
            required
            class="w-full px-3.5 py-2.5 rounded-lg text-sm bg-[var(--input-background)] border border-[var(--border)] text-[var(--text)] outline-none focus:border-[var(--accent)] transition-all font-sans"
          />
        </div>

        <div class="p-2.5 rounded-lg bg-[var(--surface-soft)] border border-[var(--border)] text-[11px] text-[var(--muted)] leading-relaxed">
          🔒 No database or remote login. Your identity and workspace persist exclusively in your browser via <code>localStorage</code>.
        </div>

        <button
          type="submit"
          class="w-full py-2.5 px-4 rounded-lg text-xs font-bold uppercase tracking-wider bg-[var(--action-background)] text-[var(--action-foreground)] shadow-sm hover:opacity-95 transition-all cursor-pointer"
        >
          Enter Workspace
        </button>
      </form>
    </div>
  </div>

  <script>
    function toggleVoidLabTheme() {
      var html = document.documentElement;
      var cur = html.getAttribute('data-theme') || 'light';
      var next = cur === 'dark' ? 'light' : 'dark';
      html.setAttribute('data-theme', next);
      localStorage.setItem('voidlab_theme', next);
      document.cookie = "voidlab_theme=" + next + "; path=/; max-age=31536000";
    }

    // --- 100% Stateless JWT Auth & Local Storage Cache Strategy (Directive 1 & 2) ---
    function handleVoidlabAuthSubmit(e) {
      if (e) e.preventDefault();
      var input = document.getElementById('voidlab-username-input');
      var username = (input ? input.value.trim() : '') || 'Rudra';

      // Request signed JWT session cookie from backend (Stateless HMAC-SHA256)
      fetch('/api/auth/login', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/x-www-form-urlencoded',
          'HX-Request': 'true'
        },
        body: 'username=' + encodeURIComponent(username)
      })
      .then(function(res) {
        if (res.ok) {
          // Persist ONLY non-sensitive UI profile state locally
          window.voidlabSaveProfile(username, null, false);
          var modal = document.getElementById('voidlab-auth-modal');
          if (modal) modal.classList.add('hidden');

          // If on landing page, navigate to editor
          if (window.location.pathname === '/' || window.location.pathname === '') {
            window.location.href = '/editor';
          }
        } else {
          console.error('[VoidLAB Auth] Failed to sign JWT session');
        }
      })
      .catch(function(err) {
        console.error('[VoidLAB Auth] Network error during login:', err);
      });
    }

    window.voidlabSaveProfile = function(username, bio, syncBackend) {
      var profile = {
        username: username,
        bio: bio || 'Voxion Labs Principal Engineer',
        updatedAt: new Date().toISOString()
      };
      // Save non-sensitive UI state to localStorage
      localStorage.setItem('voidlab_profile', JSON.stringify(profile));
      window.voidlabApplyProfile(profile);

      // If requested (e.g. username updated from settings or profile edit), refresh backend JWT
      if (syncBackend) {
        fetch('/api/auth/login', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
            'HX-Request': 'true'
          },
          body: 'username=' + encodeURIComponent(username)
        }).catch(function(err) {
          console.warn('[VoidLAB Auth] Session refresh failed:', err);
        });
      }
    };

    window.voidlabGetProfile = function() {
      var raw = localStorage.getItem('voidlab_profile');
      if (!raw) return null;
      try {
        var p = JSON.parse(raw);
        if (p && typeof p === 'object') return p;
        return { username: raw };
      } catch (e) {
        return { username: raw };
      }
    };

    window.voidlabApplyProfile = function(profile) {
      if (!profile || !profile.username) return;
      var u = profile.username;
      var initial = u.charAt(0).toUpperCase();
      document.querySelectorAll('.voidlab-user-name').forEach(function(el) { el.textContent = u; });
      document.querySelectorAll('.voidlab-user-initial').forEach(function(el) { el.textContent = initial; });
      var tagUser = document.getElementById('navbar-user-initial');
      if (tagUser) tagUser.textContent = initial;

      var profFull = document.getElementById('prof-fullname');
      if (profFull && !profFull.value) profFull.value = u;
      var profUser = document.getElementById('prof-username');
      if (profUser && (!profUser.value || profUser.value === 'Alex')) profUser.value = u;
      var profEmail = document.getElementById('prof-email');
      if (profEmail && (!profEmail.value || profEmail.value === 'me@local.dev')) profEmail.value = u + '@local.dev';
      var heroEmail = document.getElementById('profile-hero-email');
      if (heroEmail) heroEmail.textContent = u + '@local.dev';
      var profBio = document.getElementById('prof-bio');
      if (profBio && profile.bio) profBio.value = profile.bio;
    };

    window.voidlabLogout = function() {
      // Clear non-sensitive UI cache
      localStorage.removeItem('voidlab_profile');

      // Tell backend to clear the secure HTTP-only JWT cookie
      fetch('/api/auth/logout', {
        method: 'POST',
        headers: { 'HX-Request': 'true' }
      })
      .finally(function() {
        if (window.location.pathname !== '/') {
          window.location.href = '/';
        } else {
          var modal = document.getElementById('voidlab-auth-modal');
          if (modal) {
            modal.classList.remove('hidden');
            var input = document.getElementById('voidlab-username-input');
            if (input) { input.value = ''; input.focus(); }
          }
        }
      });
    };

    // --- Dynamic Side-Panel Helpers (Directive 1) ---
    window.closeSidePanel = function() {
      var panel = document.getElementById('side-panel-container');
      if (panel) {
        panel.classList.add('hidden');
        panel.innerHTML = '';
      }
    };

    // Auto-reveal side panel when HTMX swaps content into it
    document.body.addEventListener('htmx:afterSwap', function(evt) {
      if (evt.detail.target.id === 'side-panel-container') {
        evt.detail.target.classList.remove('hidden');
        var profile = window.voidlabGetProfile();
        if (profile) window.voidlabApplyProfile(profile);
      }
    });

    // Check localStorage cache and backend JWT authentication status on load
    document.addEventListener('DOMContentLoaded', function() {
      var profile = window.voidlabGetProfile();
      if (profile) {
        window.voidlabApplyProfile(profile);
      }

      // Check backend JWT session validity
      fetch('/api/auth/status')
        .then(function(res) {
          if (res.ok) {
            var authenticatedUser = res.headers.get('X-Authenticated-User');
            if (authenticatedUser && (!profile || profile.username !== authenticatedUser)) {
              window.voidlabSaveProfile(authenticatedUser, null, false);
            }
          } else {
            // Unauthenticated or expired JWT session
            if (window.location.pathname.startsWith('/editor')) {
              var modal = document.getElementById('voidlab-auth-modal');
              if (modal) {
                modal.classList.remove('hidden');
                var input = document.getElementById('voidlab-username-input');
                if (input) input.focus();
              }
            }
          }
        })
        .catch(function() {
          if (profile) {
            window.voidlabApplyProfile(profile);
          }
        });
    });

    // Restore saved theme on load
    (function() {
      var saved = localStorage.getItem('voidlab_theme');
      if (saved) {
        document.documentElement.setAttribute('data-theme', saved);
      }
    })();
  </script>
</body>
</html>
